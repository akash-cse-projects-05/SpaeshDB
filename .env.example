# Server Configuration
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001

# MongoDB Connection String (Atlas or Local)
# Replace with your MongoDB cluster URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/sparsh_care?retryWrites=true&w=majority

# Session Secret (Use a strong, random 32+ character string in production)
SESSION_SECRET=your_super_secret_session_key_here

# Default System Administrator Password
# Used on first boot to seed the admin account (admin@sparsh.org)
ADMIN_PASSWORD=your_secure_admin_password_here

# Twilio WhatsApp Credentials (Optional - for WhatsApp alerts & AI booking bot)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# SMTP Email Configuration (Optional - for appointment notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
