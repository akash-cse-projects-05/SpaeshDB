<script>
  function switchAdminTab(panelId) {
    const panels = ['docs', 'revenue', 'blog'];
    panels.forEach(p => {
      const panelEl = document.getElementById('admin-panel-' + p);
      if (panelEl) {
        panelEl.style.display = p === panelId ? 'block' : 'none';
        panelEl.classList.toggle('active', p === panelId);
      }
      
      const tabButton = document.getElementById('admin-tab-' + p);
      if (tabButton) {
        tabButton.classList.toggle('active', p === panelId);
      }
    });
  }

  // Modal control functions
  function openRegisterModal() {
    const modal = document.getElementById('register-doctor-modal');
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeRegisterModal() {
    const modal = document.getElementById('register-doctor-modal');
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }

  // Close modal when clicking outside of modal card
  window.addEventListener('click', (e) => {
    const modal = document.getElementById('register-doctor-modal');
    if (e.target === modal) {
      closeRegisterModal();
    }
  });

  // Set default panel view states on load
  document.addEventListener('DOMContentLoaded', () => {
    switchAdminTab('docs');
  });

  // Export Practitioners Directory Table to CSV
  function exportTableToCSV(filename) {
    const csv = [];
    const rows = document.querySelectorAll("#doctors-table tr");
    
    for (let i = 0; i < rows.length; i++) {
        let row = [], cols = rows[i].querySelectorAll("td, th");
        let maxCols = Math.min(cols.length, 5); 
        for (let j = 0; j < maxCols; j++) 
            row.push('"' + cols[j].innerText.replace(/\s+/g, ' ').replace(/"/g, '""').trim() + '"');
        csv.push(row.join(","));
    }

    const csvFile = new Blob([csv.join("\n")], {type: "text/csv"});
    const downloadLink = document.createElement("a");
    downloadLink.download = filename;
    downloadLink.href = window.URL.createObjectURL(csvFile);
    downloadLink.style.display = "none";
    document.body.appendChild(downloadLink);
    downloadLink.click();
    document.body.removeChild(downloadLink);
  }

  // Export Doctor Earnings & Revenue Matrix Table to CSV
  function exportRevenueTableToCSV(filename) {
    const csv = [];
    const rows = document.querySelectorAll("#revenue-table tr");
    
    for (let i = 0; i < rows.length; i++) {
        let row = [], cols = rows[i].querySelectorAll("td, th");
        for (let j = 0; j < cols.length; j++) 
            row.push('"' + cols[j].innerText.replace(/\s+/g, ' ').replace(/"/g, '""').trim() + '"');
        csv.push(row.join(","));
    }

    const csvFile = new Blob([csv.join("\n")], {type: "text/csv"});
    const downloadLink = document.createElement("a");
    downloadLink.download = filename;
    downloadLink.href = window.URL.createObjectURL(csvFile);
    downloadLink.style.display = "none";
    document.body.appendChild(downloadLink);
    downloadLink.click();
    document.body.removeChild(downloadLink);
  }
</script>

