<%- include('../partials/header') %>

  <style>
    main {
      max-width: 1200px !important;
      padding: 2rem 1.5rem !important;
      margin: 0 auto;
    }

    .dossier-grid {
      display: grid;
      grid-template-columns: 1.6fr 1fr;
      gap: 2rem;
      align-items: start;
      margin-bottom: 3.5rem;
    }

    @media (max-width: 992px) {
      .dossier-grid {
        grid-template-columns: 1fr;
      }
    }

    .slot-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
      gap: 0.6rem;
    }
  </style>

  <div style="max-width: 100%; margin: 0 auto; width: 100%;">

    <!-- Back Navigation & Breadcrumb -->
    <div
      style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.88rem;">
        <a href="/admin/dashboard"
          style="color: var(--text-secondary); text-decoration: none; font-weight: 600; transition: color 0.15s;"
          onmouseover="this.style.color='var(--primary)'"
          onmouseout="this.style.color='var(--text-secondary)'">Operations Console</a>
        <span style="color: var(--text-muted);">/</span>
        <span style="color: var(--text); font-weight: 700;">Specialist Profile</span>
      </div>
    </div>

    <!-- Doctor Header Section (Clean Native Display) -->
    <div
      style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem; margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border);">
      <div style="display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
        <!-- Avatar Frame -->
        <div
          style="width: 76px; height: 76px; border-radius: 50%; background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%); display: flex; align-items: center; justify-content: center; color: white; font-size: 2rem; font-weight: 800; box-shadow: 0 4px 12px rgba(13, 148, 136, 0.15); flex-shrink: 0;">
          <%= doctor.name.charAt(0) || 'D' %>
        </div>
        <div>
          <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.35rem;">
            <% if (averageRating> 0) { %>
              <span
                style="font-size: 0.82rem; font-weight: 700; color: #f59e0b; display: flex; align-items: center; gap: 0.25rem; background: rgba(245, 158, 11, 0.08); padding: 4px 8px; border-radius: 6px; border: 1px solid rgba(245, 158, 11, 0.15);">
                ⭐ <%= averageRating %> / 5.0 Rating
              </span>
              <% } %>
          </div>
          <h1
            style="font-size: 2rem; font-weight: 800; color: var(--text); margin: 0; letter-spacing: -0.03em; display: flex; align-items: center; gap: 0.5rem;">
            <%= doctor.name %>
              <% if (doctor.isApproved) { %>
                <span style="color: #10b981; font-size: 1.2rem; display: inline-flex;"
                  title="Verified Professional">✓</span>
                <% } else { %>
                  <span style="color: #f59e0b; font-size: 1.2rem; display: inline-flex;"
                    title="Verification Pending">⏳</span>
                  <% } %>
          </h1>
          <p
            style="color: var(--text-secondary); font-size: 0.95rem; margin: 0.35rem 0 0 0; font-weight: 600; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
            <span style="color: var(--primary);">
              <%= doctor.specialization %>
            </span>
            <span style="color: var(--text-muted);">&middot;</span>
            <span>
              <%= doctor.qualification %>
            </span>
            <span
              style="background: rgba(15, 23, 42, 0.05); font-size: 0.72rem; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: var(--text-secondary); border: 1px solid var(--border);">
              <%= doctor.gender || 'Male' %>
            </span>
          </p>
        </div>
      </div>
      <div>
        <form action="/admin/doctor/toggle" method="POST" style="margin: 0; display: inline;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="doctorId" value="<%= doctor._id %>">
          <% if (doctor.isApproved) { %>
            <button type="submit" name="action" value="disapprove" class="btn btn-secondary"
              style="padding: 0.55rem 1.25rem; font-size: 0.82rem; font-weight: 700; border-color: rgba(220,38,38,0.25); color: #dc2626; background: rgba(220,38,38,0.02); border-radius: 8px; cursor: pointer; transition: all 0.15s;">
              Revoke Credentials
            </button>
            <% } else { %>
              <button type="submit" name="action" value="approve" class="btn btn-primary"
                style="padding: 0.55rem 1.35rem; font-size: 0.82rem; font-weight: 700; background: var(--primary); border-radius: 8px; border: none; color: white; cursor: pointer; box-shadow: 0 4px 10px rgba(13, 148, 136, 0.12); transition: all 0.15s;">
                Approve Practitioner
              </button>
              <% } %>
        </form>
      </div>
    </div>

    <!-- DOUBLE COLUMN CONTENT GRID -->
    <div class="dossier-grid">

      <!-- LEFT SIDE: Profile info, availability, booking timeline -->
      <div style="display: flex; flex-direction: column; gap: 2rem;">

        <!-- Bio Coordinates -->
        <div class="card-premium"
          style="border-radius: 16px; padding: 2rem; border: 1px solid var(--border); background: var(--card-bg);">
          <h3
            style="color: var(--text); font-size: 1.25rem; font-weight: 800; margin-top: 0; margin-bottom: 1.25rem; letter-spacing: -0.02em;">
            Professional Bio & Coordinates</h3>
          <p style="color: var(--text-secondary); line-height: 1.6; font-size: 0.95rem; margin-bottom: 1.75rem;">
            <%= doctor.bio || 'No professional bio registered on Sparsh network.' %>
          </p>

          <div
            style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
            <div>
              <div
                style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em; margin-bottom: 0.4rem;">
                Communications Address</div>
              <div style="font-size: 0.88rem; color: var(--text); font-weight: 600; line-height: 1.5;">
                📧 <%= doctor.email %><br>
                  📞 <%= doctor.phoneNumber || 'No phone registered' %>
              </div>
            </div>
            <div>
              <div
                style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em; margin-bottom: 0.4rem;">
                Billing & Fees</div>
              <div style="font-size: 1.15rem; color: var(--text); font-weight: 850;">₹<%= doctor.consultationFee || 500
                  %> <span style="font-size: 0.8rem; color: var(--text-secondary); font-weight: 500;">/ session</span>
              </div>
            </div>
          </div>
        </div>


        <!-- Consultation Directory Ledger -->
        <div class="card-premium"
          style="border-radius: 16px; padding: 1.5rem; border: 1px solid var(--border); background: var(--card-bg); overflow: hidden;">
          <div style="padding: 0.5rem 0.5rem 1.5rem 0.5rem;">
            <h3 style="color: var(--text); font-size: 1.25rem; font-weight: 800; margin: 0; letter-spacing: -0.02em;">
              Consultation Directory Ledger</h3>
            <p style="color: var(--text-secondary); font-size: 0.88rem; margin: 0.25rem 0 0 0;">Chronological list of
              all patient appointments.</p>
          </div>

          <% if (appointments && appointments.length> 0) { %>
            <div class="table-responsive" style="max-height: 380px; overflow-y: auto; overflow-x: auto; -webkit-overflow-scrolling: touch;">
              <table class="admin-table" style="width: 100%; border-collapse: collapse; min-width: 600px;">
                <thead>
                  <tr>
                    <th style="padding-left: 1rem;">Patient Name</th>
                    <th>Date & Time</th>
                    <th>Mode</th>
                    <th>Status</th>
                    <th style="text-align: right; padding-right: 1rem;">Session Fee</th>
                  </tr>
                </thead>
                <tbody>
                  <% appointments.forEach(app=> {
                    let dateStr = 'N/A';
                    let timeStr = 'N/A';
                    try {
                      const rawDate = (app.appointmentSlot && app.appointmentSlot.date) || app.date || app.createdAt;
                      dateStr = new Date(rawDate).toISOString().split('T')[0];
                    } catch(e) {}
                    try {
                      timeStr = (app.appointmentSlot && app.appointmentSlot.time) || app.time || 'N/A';
                    } catch(e) {}
                    %>
                    <tr class="admin-table-row">
                      <td style="padding-left: 1rem;">
                        <strong style="color: var(--text); font-weight: 700; font-size: 0.9rem;">
                          <%= app.patientId ? (app.patientId.isAnonymous ? 'Anonymous Patient' : app.patientId.name)
                            : 'Guest Patient' %>
                        </strong>
                      </td>
                      <td>
                        <div style="font-weight: 600; color: var(--text-secondary); font-size: 0.82rem;">
                          📅 <%= dateStr %>
                        </div>
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.1rem;">
                          🕒 <%= timeStr %>
                        </div>
                      </td>
                      <td>
                        <span
                          style="font-size: 0.72rem; font-weight: 700; background: rgba(15, 23, 42, 0.05); color: var(--text-secondary); padding: 2px 6px; border-radius: 4px;">
                          <%= app.consultationMode %>
                        </span>
                      </td>
                      <td>
                        <span
                          class="admin-badge <%= app.status === 'Completed' ? 'admin-badge-success' : (app.status === 'Cancelled' ? 'admin-badge-danger' : 'admin-badge-warning') %>"
                          style="font-size: 0.65rem; padding: 2px 6px; border-radius: 4px;">
                          <%= app.status %>
                        </span>
                      </td>
                      <td
                        style="text-align: right; padding-right: 1rem; font-weight: 800; color: var(--primary); font-size: 0.9rem;">
                        ₹<%= doctor.consultationFee || 500 %>
                      </td>
                    </tr>
                    <% }) %>
                </tbody>
              </table>
            </div>
            <% } else { %>
              <div
                style="text-align: center; padding: 3rem 1.5rem; color: var(--text-secondary); font-style: italic; font-size: 0.9rem; border: 1px dashed var(--border); border-radius: 12px; background: rgba(15,23,42,0.01);">
                No historical bookings found.
              </div>
              <% } %>
        </div>

      </div>

      <!-- RIGHT SIDE: Overview widgets, feedback commentary -->
      <div style="display: flex; flex-direction: column; gap: 2rem;">

        <!-- Box 1: Case statistics card -->
        <div class="card-premium"
          style="border-radius: 16px; padding: 1.75rem; border: 1px solid var(--border); background: var(--card-bg);">
          <h4
            style="margin-top: 0; color: var(--text); font-size: 0.95rem; font-weight: 800; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; margin-bottom: 1rem;">
            Case Metrics Dashboard</h4>

          <div style="display: flex; flex-direction: column; gap: 0.88rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
              <span style="color: var(--text-secondary); font-weight: 500;">Total Bookings:</span>
              <strong style="color: var(--text);">
                <%= stats.total %>
              </strong>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
              <span style="color: var(--text-secondary); font-weight: 500;">Completed Cases:</span>
              <strong style="color: #10b981;">
                <%= stats.completed %>
              </strong>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
              <span style="color: var(--text-secondary); font-weight: 500;">Confirmed Slots:</span>
              <strong style="color: #3b82f6;">
                <%= stats.confirmed %>
              </strong>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
              <span style="color: var(--text-secondary); font-weight: 500;">Pending Review:</span>
              <strong style="color: #f59e0b;">
                <%= stats.pending %>
              </strong>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
              <span style="color: var(--text-secondary); font-weight: 500;">Cancelled:</span>
              <strong style="color: #ef4444;">
                <%= stats.cancelled %>
              </strong>
            </div>

            <a href="/admin/doctor/<%= doctor._id %>/analytics" class="btn btn-primary"
              style="margin-top: 1rem; width: 100%; border-radius: 8px; padding: 0.6rem; font-size: 0.82rem; font-weight: 700; text-align: center; text-decoration: none; display: block; box-sizing: border-box; background: var(--primary); color: white; border: none; cursor: pointer;">
              📈 Access Detailed Analytics Board
            </a>
          </div>
        </div>

        <!-- Feedback Commentary -->
        <div class="card-premium"
          style="border-radius: 16px; padding: 2rem; border: 1px solid var(--border); background: var(--card-bg);">
          <h3
            style="color: var(--text); font-size: 1.25rem; font-weight: 800; margin-top: 0; margin-bottom: 0.25rem; letter-spacing: -0.02em;">
            Feedback Commentary</h3>
          <p style="color: var(--text-secondary); font-size: 0.88rem; margin-bottom: 1.5rem;">Direct feedback commentary
            and reviews left by patients.</p>

          <% if (doctor.ratings && doctor.ratings.length> 0) { %>
            <div
              style="display: flex; flex-direction: column; gap: 1rem; max-height: 380px; overflow-y: auto; padding-right: 0.25rem;">
              <% doctor.ratings.forEach(review=> { %>
                <div
                  style="border-bottom: 1px solid var(--border); padding-bottom: 0.88rem; &:last-child { border-bottom: none; padding-bottom: 0; }">
                  <div
                    style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.25rem;">
                    <strong style="color: var(--text); font-size: 0.88rem;">
                      <%= review.patientName %>
                    </strong>
                    <span style="color: #f59e0b; font-weight: 700; font-size: 0.8rem;">
                      <%= '★' .repeat(review.score) %>
                        <%= '☆' .repeat(5 - review.score) %>
                    </span>
                  </div>
                  <p
                    style="color: var(--text-secondary); font-size: 0.82rem; line-height: 1.45; margin: 0.2rem 0; font-style: italic; background: rgba(15,23,42,0.01); border-left: 3px solid var(--primary); padding-left: 0.5rem;">
                    "<%= review.reviewText %>"
                  </p>
                  <div style="font-size: 0.7rem; color: var(--text-muted); text-align: right;">
                    Submitted on <%= new Date(review.createdAt || Date.now()).toLocaleDateString() %>
                  </div>
                </div>
                <% }) %>
            </div>
            <% } else { %>
              <div
                style="font-size: 0.85rem; color: var(--text-secondary); font-style: italic; text-align: center; padding: 1.5rem 0;">
                No patient reviews recorded yet.
              </div>
              <% } %>
        </div>

        <!-- Quick Action: Delete credentials profile -->
        <div class="card-premium"
          style="border-radius: 16px; padding: 1.5rem; border: 1px solid rgba(239, 68, 68, 0.15); background: rgba(239, 68, 68, 0.02); text-align: center;">
          <h4 style="margin-top: 0; color: #ef4444; font-size: 0.95rem; font-weight: 800; margin-bottom: 0.5rem;">Danger
            Zone</h4>
          <p style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 1.25rem; line-height: 1.4;">
            Permanently delete this practitioner profile. Active bookings will be cancelled immediately.</p>
          <form action="/admin/doctor/delete" method="POST" style="margin: 0;"
            onsubmit="return confirm('Are you sure you want to delete this doctor? Active appointments will be cancelled.');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="doctorId" value="<%= doctor._id %>">
            <button type="submit" class="btn btn-danger"
              style="width: 100%; border-radius: 8px; padding: 0.6rem; font-size: 0.82rem; font-weight: 700; background: #dc2626; color: #fff; border: none; cursor: pointer; transition: background 0.15s; box-sizing: border-box;">
              Remove Doctor Account
            </button>
          </form>
        </div>

      </div>

    </div>

  </div>

  <%- include('../partials/footer') %>