<%- include('../partials/header') %>

  <style>
    main {
      max-width: 1200px !important;
      padding: 1.5rem 1.75rem !important;
    }
  </style>

  <div style="max-width: 100%; margin: 0rem auto; width: 100%;">

    <!-- Header Section -->
    <div class="dashboard-header patient-dashboard-header"
      style="display: flex; justify-content: space-between; align-items: center; flex-wrap: nowrap; gap: 2rem; margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border);">
        <div style="flex: 1 1 auto; min-width: 300px;">
          <h1 class="dashboard-title"
            style="font-size: 2.0rem; font-weight: 700; color: var(--text); letter-spacing: -0.03em; margin: 0 0 0.35rem 0;">
            <%= currentUser.isAnonymous ? 'Anonymous Session' : `Welcome, ${currentUser.name}` %>
          </h1>
          <p class="dashboard-welcome"
            style="color: var(--text-secondary); font-size: 0.95rem; margin: 0; max-width: 600px; line-height: 1.4;">
            <%= currentUser.isAnonymous
              ? 'Your medical inquiries are currently protected under an anonymous veil. No identity footprint is stored.'
              : 'Manage your clinical files, track consultation history, and provision new telehealth appointments.' %>
          </p>
        </div>
    </div>

    <!-- Primary Section Navigation -->
    <div class="navigation-tabs" role="tablist" aria-label="Patient dashboard sections"
      style="margin-bottom: 2rem; display: flex; gap: 2rem; border-bottom: 1px solid var(--border); background: transparent; padding: 0; border-radius: 0;">
      <button class="navigation-tab active" type="button" data-panel="appointments-panel"
        style="padding: 0.75rem 0.5rem; font-weight: 600; font-size: 1rem; border: none; background: transparent; border-bottom: 2px solid var(--primary); color: var(--text); cursor: pointer; border-radius: 0; flex: none;">
        My Consultations
      </button>
      <button class="navigation-tab" type="button" data-panel="book-panel"
        style="padding: 0.75rem 0.5rem; font-weight: 500; font-size: 1rem; border: none; background: transparent; border-bottom: 2px solid transparent; color: var(--text-secondary); cursor: pointer; border-radius: 0; flex: none;">
        Book Consultation
      </button>
      <button class="navigation-tab" type="button" data-panel="medical-panel"
        style="padding: 0.75rem 0.5rem; font-weight: 500; font-size: 1rem; border: none; background: transparent; border-bottom: 2px solid transparent; color: var(--text-secondary); cursor: pointer; border-radius: 0; flex: none;">
        Medical Identity
      </button>
    </div>

    <!-- PANELS -->

    <!-- Panel 1: Appointments -->
    <div id="appointments-panel" class="dashboard-panel active">
      <div style="margin-bottom: 1.5rem;">
        <h2 style="font-size: 1.35rem; font-weight: 700; color: var(--text); margin-bottom: 0.25rem;">Appointments &
          History</h2>
        <p style="color: var(--text-secondary); font-size: 0.9rem;">You have <%= appointments.length %> appointment<%=
              appointments.length===1 ? '' : 's' %> registered</p>
      </div>

      <!-- PEP 72-Hour Emergency Exposure Countdown -->
      <% if (currentUser.pepExposureDate) { %>
        <%
          const exposureTime = new Date(currentUser.pepExposureDate);
          const endTime = new Date(exposureTime.getTime() + 72 * 60 * 60 * 1000);
          const pepActive = endTime > new Date();
        %>
        <% if (pepActive) { %>
          <div class="card-premium" style="background: rgba(239, 68, 68, 0.05); border: 2px solid #ef4444; border-radius: 12px; padding: 1.25rem; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
            <div style="flex: 1; min-width: 280px;">
              <h3 style="color: #ef4444; font-size: 1.15rem; font-weight: 800; margin: 0 0 0.4rem 0; display: flex; align-items: center; gap: 0.5rem;">
                🚨 Emergency PEP Window Active
              </h3>
              <p style="color: var(--text-secondary); font-size: 0.85rem; margin: 0; line-height: 1.45;">
                Post-Exposure Prophylaxis (PEP) must be started within <strong>72 hours</strong> of potential exposure to prevent infection. 
                Your registered exposure event occurred on <%= exposureTime.toLocaleString() %>.
              </p>
            </div>
            <div style="text-align: right; min-width: 200px;">
              <div id="pep-countdown-timer" data-end="<%= endTime.toISOString() %>" style="font-size: 1.75rem; font-weight: 800; color: #ef4444; font-family: monospace; letter-spacing: 1px;">
                --:--:--
              </div>
              <div style="font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 600; margin-bottom: 0.5rem;">Time Remaining to Start PEP</div>
              <button class="btn btn-primary" onclick="switchPanel('book-panel')" style="background: #ef4444; border-color: #ef4444; font-weight: 700; padding: 0.45rem 1.15rem; font-size: 0.8rem;">
                ⚡ Fast Book PEP Now
              </button>
            </div>
          </div>
        <% } %>
      <% } %>

      <!-- PrEP Pill Tracker Card -->
      <div class="card-premium" style="background: rgba(13, 148, 136, 0.03); border: 1px solid rgba(13, 148, 136, 0.2); border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
        <div style="display: flex; align-items: center; gap: 0.85rem; flex: 1; min-width: 250px;">
          <div style="font-size: 1.75rem;">💊</div>
          <div>
            <h4 style="color: var(--text); font-weight: 700; margin: 0 0 0.2rem 0; font-size: 0.95rem;">PrEP Adherence Tracker & Pill Log</h4>
            <p style="color: var(--text-secondary); font-size: 0.82rem; margin: 0;">
              <% if (currentUser.prepTracking && currentUser.prepTracking.isActive) { %>
                🔥 Current Adherence Streak: <strong><%= currentUser.prepTracking.currentStreak || 0 %> days</strong>. Keep it up!
              <% } else { %>
                Start tracking your daily PrEP compliance to ensure maximum protection.
              <% } %>
            </p>
          </div>
        </div>
        <a href="/patient/prep-tracker" class="btn btn-primary" style="font-size: 0.8rem; padding: 0.45rem 1.15rem; font-weight: 700;">
          <%= (currentUser.prepTracking && currentUser.prepTracking.isActive) ? 'Open Daily Tracker' : 'Activate Tracker' %>
        </a>
      </div>

      <% if (appointments.length) { %>
        <!-- Live Countdown Timer -->
        <% 
          let nextApp = null;
          const now = new Date();
          const upcomingApps = appointments.filter(a => {
            if (a.status !== 'Confirmed' && a.status !== 'Upcoming') return false;
            const dateStr = a.appointmentSlot?.date || a.date;
            const timeStr = a.appointmentSlot?.time || a.time;
            if (!dateStr || !timeStr) return false;
            const dt = new Date(`${dateStr.toString().split('T')[0]}T${timeStr.split('-')[0].trim()}:00`);
            return dt > now;
          }).sort((a,b) => {
            const d1 = new Date(`${(a.appointmentSlot?.date||a.date).toString().split('T')[0]}T${(a.appointmentSlot?.time||a.time).split('-')[0].trim()}:00`);
            const d2 = new Date(`${(b.appointmentSlot?.date||b.date).toString().split('T')[0]}T${(b.appointmentSlot?.time||b.time).split('-')[0].trim()}:00`);
            return d1 - d2;
          });
          if (upcomingApps.length > 0) nextApp = upcomingApps[0];
        %>

        <% if (nextApp) { %>
          <div style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border-radius: 12px; padding: 1rem 1.5rem; margin-bottom: 1.5rem; color: white; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 10px 20px -5px rgba(15,23,42,0.2); flex-wrap: wrap; gap: 1rem;">
            <div>
              <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: rgba(255,255,255,0.7); font-weight: 600; margin-bottom: 0.25rem;">Next Upcoming Consultation</div>
              <div style="font-size: 1.15rem; font-weight: 700;">Dr. <%= (nextApp.doctorName || (nextApp.doctorId && nextApp.doctorId.name) || 'Doctor').replace(/^Dr\.\s*/i, '') %> &mdash; <%= nextApp.consultationType || 'General Checkup' %></div>
            </div>
            <div style="text-align: right;">
              <div id="countdown-timer" data-target="<%= new Date(`${(nextApp.appointmentSlot?.date||nextApp.date).toString().split('T')[0]}T${(nextApp.appointmentSlot?.time||nextApp.time).split('-')[0].trim()}:00`).toISOString() %>" style="font-size: 1.5rem; font-weight: 800; font-variant-numeric: tabular-nums; color: #34d399; letter-spacing: 1px;">
                --:--:--
              </div>
              <div style="font-size: 0.7rem; color: rgba(255,255,255,0.6); font-weight: 500; margin-bottom: 0.35rem;">Hours : Minutes : Seconds</div>
              <a href="/consultation/room" class="btn" style="background: rgba(52, 211, 153, 0.1); border: 1px solid #34d399; color: #34d399; padding: 0.25rem 1rem; font-size: 0.75rem; border-radius: 20px;">
                Join Call
              </a>
            </div>
          </div>
        <% } %>

        <div style="overflow-x: auto; background: var(--bg); border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 4px 12px -2px rgba(0,0,0,0.03);">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.88rem;">
            <thead>
              <tr style="border-bottom: 1px solid var(--border); background: rgba(0,0,0,0.015);">
                <th style="padding: 1rem 1.15rem; font-weight: 600; color: var(--text-secondary); width: 30%;">
                  Medical Specialist</th>
                <th style="padding: 1rem 1.15rem; font-weight: 600; color: var(--text-secondary); width: 22%;">
                  Schedule Window</th>
                <th style="padding: 1rem 1.15rem; font-weight: 600; color: var(--text-secondary); width: 23%;">
                  Modality / Service</th>
                <th style="padding: 1rem 1.15rem; font-weight: 600; color: var(--text-secondary); width: 12%;">State Status</th>
                <th style="padding: 1rem 1.15rem; font-weight: 600; color: var(--text-secondary); text-align: right; width: 13%;">
                  Actions</th>
              </tr>
            </thead>
            <tbody>
              <% appointments.forEach(app=> { %>
                <% let docName=app.doctorName || 'N/A' ; let docSpecialization='Infectious Disease' ; if (app.doctorId) {
                  docName=app.doctorId.name; docSpecialization=app.doctorId.specialization || docSpecialization; } let
                  displayDate='N/A' ; let displayTime='N/A' ; if (app.appointmentSlot && app.appointmentSlot.date) { try {
                  if (app.appointmentSlot.date instanceof Date) {
                  displayDate=app.appointmentSlot.date.toISOString().split('T')[0]; } else { displayDate=new
                  Date(app.appointmentSlot.date).toISOString().split('T')[0]; } } catch (e) {
                  displayDate=app.appointmentSlot.date.toString(); } displayTime=app.appointmentSlot.time; } else if
                  (app.date) { displayDate=app.date; displayTime=app.time; } %>
                  <% let currentStatus=(app.status || 'Pending' ).toLowerCase(); %>
                  <tr style="border-bottom: 1px solid var(--border); transition: background 0.2s;">
                    <td style="padding: 1rem 1.15rem;">
                      <div style="font-weight: 600; color: var(--text); font-size: 0.92rem;">
                        <%= docName %>
                      </div>
                      <div style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.15rem;">
                        <%= docSpecialization %>
                      </div>
                    </td>
                    <td style="padding: 1rem 1.15rem;">
                      <div style="font-weight: 500; color: var(--text);">
                        <%= displayDate %>
                      </div>
                      <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.15rem;">
                        <%= displayTime %>
                      </div>
                    </td>
                    <td style="padding: 1rem 1.15rem;">
                      <div style="color: var(--text); font-weight: 500;">
                        <%= app.consultationType %>
                      </div>
                      <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.15rem; display: flex; align-items: center; gap: 0.35rem;">
                        <span style="width: 6px; height: 6px; border-radius: 50%; background: <%= (app.consultationMode || '').toLowerCase().includes('video') ? '#2563eb' : '#db2777' %>;"></span>
                        <%= (app.consultationMode || 'Video' ).replace(' Consultation', '' ) %>
                      </div>
                    </td>
                    <td style="padding: 1rem 1.15rem;">
                      <% let badgeColor='#475569' ; let badgeBg='#f8fafc' ; if (['confirmed', 'upcoming'
                        ].includes(currentStatus)) { badgeColor='#16a34a' ; badgeBg='#f0fdf4' ; } else if
                        (currentStatus==='completed' ) { badgeColor='#2563eb' ; badgeBg='#eff6ff' ; } else if
                        (currentStatus==='cancelled' ) { badgeColor='#dc2626' ; badgeBg='#fef2f2' ; } %>
                        <span style="display: inline-flex; padding: 0.25rem 0.65rem; border-radius: 6px; font-size: 0.75rem; font-weight: 600; color: <%= badgeColor %>; background: <%= badgeBg %>; text-transform: capitalize;">
                          <%= app.status %>
                        </span>
                    </td>
                    <td style="padding: 1rem 1.15rem; text-align: right;">
                      <div style="display: flex; justify-content: flex-end; gap: 0.5rem; align-items: center;">
                        <a href="/appointments/<%= app._id %>"
                          style="padding: 0.4rem 0.85rem; font-size: 0.8rem; font-weight: 500; border: 1px solid var(--border); color: var(--text-secondary); background: white; border-radius: 6px; text-decoration: none;">
                          Details
                        </a>
                        <% if (app.status==='Pending' || app.status==='Confirmed' ) { %>
                          <form action="/appointments/<%= app._id %>/cancel" method="POST"
                            onsubmit="return confirm('Cancel this appointment?');" style="margin: 0;">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" aria-label="Cancel Appointment"
                              style="padding: 0.4rem 0.85rem; font-size: 0.8rem; font-weight: 600; background: #fef2f2; border: 1px solid rgba(239, 68, 68, 0.15); border-radius: 6px; color: #ef4444; cursor: pointer; transition: background 0.2s;"
                              onmouseover="this.style.background='#fee2e2';" onmouseout="this.style.background='#fef2f2';">
                              Cancel
                            </button>
                          </form>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }) %>
            </tbody>
          </table>
        </div>
        <% } else { %>
          <div class="card-premium"
            style="text-align: center; padding: 3rem 1.5rem; background: rgba(255,255,255,0.02); border: 1px dashed var(--border);">
            <div
              style="width: 48px; height: 48px; background: rgba(13, 148, 136, 0.06); color: var(--primary); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 1.25rem; margin: 0 auto 1.25rem;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
              </svg>
            </div>
            <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--text); margin-bottom: 0.5rem;">No appointments
              booked yet</h3>
            <p style="color: var(--text-secondary); max-width: 400px; margin: 0 auto 1.25rem; font-size: 0.88rem;">Choose
              a verified specialist and a convenient slot time to start your telehealth care.</p>
            <button class="btn btn-primary" onclick="switchPanel('book-panel')"
              style="padding: 0.55rem 1.25rem; font-weight: 700; font-size: 0.85rem;">Book Consultation</button>
          </div>
          <% } %>
    </div>

    <!-- Panel 2: Embedded Booking Wizard -->
    <div id="book-panel" class="dashboard-panel">
      <div style="max-width: 780px; margin: 0 auto;">
        <!-- Progress Bar -->
        <div
          style="display: flex; align-items: center; gap: 0; margin-bottom: 2rem; max-width: 500px; margin-left: auto; margin-right: auto;">
          <div class="progress-step active" id="progress-1">
            <div class="progress-dot">1</div>
            <span>Service</span>
          </div>
          <div class="progress-line" id="progress-line-1"></div>
          <div class="progress-step" id="progress-2">
            <div class="progress-dot">2</div>
            <span>Doctor</span>
          </div>
          <div class="progress-line" id="progress-line-2"></div>
          <div class="progress-step" id="progress-3">
            <div class="progress-dot">3</div>
            <span>Slot</span>
          </div>
          <div class="progress-line" id="progress-line-3"></div>
          <div class="progress-step" id="progress-4">
            <div class="progress-dot">4</div>
            <span>Confirm</span>
          </div>
        </div>

        <!-- Wizard Card -->
        <div class="card-premium" style="border-radius: 16px; padding: 1.75rem;">
          <h3 id="step-subtitle"
            style="font-size: 0.95rem; color: var(--text-secondary); margin-bottom: 1.25rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700;">
            Step 1 of 4 — Select Service</h3>
          <form id="booking-wizard-form" action="/patient/book" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <!-- Hidden Form Parameters -->
            <input type="hidden" name="doctorId" id="hidden-doctor-id">
            <input type="hidden" name="amount" id="hidden-amount" value="400">
            <input type="hidden" name="date" id="hidden-date">
            <input type="hidden" name="time" id="hidden-time">
            <input type="hidden" name="contactMethod" value="Email">
            <input type="hidden" name="contactValue" id="hidden-contact-value" value="<%= currentUser.email || '' %>">

            <!-- ============================================ -->
            <!-- STEP 1: Select Service                       -->
            <!-- ============================================ -->
            <div id="wizard-step-1" class="wizard-step">
              <div style="margin-bottom: 1.5rem;">
                <h2 style="font-size: 1.35rem; font-weight: 700; color: var(--text); margin-bottom: 0.25rem;">What do
                  you need help with?</h2>
                <p style="color: var(--text-secondary); font-size: 0.9rem;">Select the type of consultation you're
                  looking for.</p>
              </div>

              <div style="display: flex; flex-direction: column; gap: 1rem;">
                <div class="service-card" data-service="PEP" onclick="selectService('PEP')">
                  <div style="display: flex; align-items: center; gap: 1rem; flex: 1;">
                    <div class="service-icon" style="background: rgba(239, 68, 68, 0.06); color: #ef4444;">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                      </svg>
                    </div>
                    <div>
                      <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text); margin-bottom: 0.2rem;">PEP
                        Consultation</h3>
                      <p style="color: var(--text-secondary); font-size: 0.85rem; margin: 0;">Post-Exposure Prophylaxis
                        — Emergency treatment within 72 hours of potential HIV exposure.</p>
                    </div>
                  </div>
                  <div class="service-check">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                  </div>
                </div>

                <div class="service-card" data-service="PrEP" onclick="selectService('PrEP')">
                  <div style="display: flex; align-items: center; gap: 1rem; flex: 1;">
                    <div class="service-icon" style="background: rgba(59, 130, 246, 0.06); color: #3b82f6;">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2">
                        <path d="M18 20V10M12 20V4M6 20v-6" />
                      </svg>
                    </div>
                    <div>
                      <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text); margin-bottom: 0.2rem;">PrEP
                        Consultation</h3>
                      <p style="color: var(--text-secondary); font-size: 0.85rem; margin: 0;">Pre-Exposure Prophylaxis —
                        Daily prevention medication for individuals at higher risk.</p>
                    </div>
                  </div>
                  <div class="service-check">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                  </div>
                </div>

                <div class="service-card" data-service="General Counselling"
                  onclick="selectService('General Counselling')">
                  <div style="display: flex; align-items: center; gap: 1rem; flex: 1;">
                    <div class="service-icon" style="background: rgba(13, 148, 136, 0.06); color: #0d9488;">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                      </svg>
                    </div>
                    <div>
                      <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text); margin-bottom: 0.2rem;">
                        General Counselling</h3>
                      <p style="color: var(--text-secondary); font-size: 0.85rem; margin: 0;">Confidential guidance,
                        mental health support, and expert care planning.</p>
                    </div>
                  </div>
                  <div class="service-check">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                  </div>
                </div>
              </div>
              <input type="hidden" name="consultationType" id="hidden-service-type">
            </div>

            <!-- ============================================ -->
            <!-- STEP 2: Choose Your Doctor                   -->
            <!-- ============================================ -->
            <div id="wizard-step-2" class="wizard-step" style="display: none;">
              <div style="margin-bottom: 1.5rem;">
                <h2 style="font-size: 1.35rem; font-weight: 700; color: var(--text); margin-bottom: 0.25rem;">Choose
                  Your Specialist</h2>
                <p style="color: var(--text-secondary); font-size: 0.9rem;">Select a verified doctor for your <strong
                    id="display-selected-service" style="color: var(--primary);"></strong> consultation.</p>
              </div>

              <!-- Gender Filter Bar -->
              <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap; background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 0.5rem 1rem;">
                <span style="font-size: 0.82rem; font-weight: 700; color: var(--text-secondary); display: flex; align-items: center; gap: 0.25rem;">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="display: inline;"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                  Specialist Gender:
                </span>
                <div style="display: flex; gap: 0.35rem;">
                  <button type="button" class="gender-btn" id="gender-btn-all" onclick="filterDoctorsByGender('all')" style="padding: 0.3rem 0.8rem; font-size: 0.78rem; font-weight: 700; border-radius: 6px; border: 1px solid var(--primary); background: var(--primary); color: white; cursor: pointer; transition: all 0.2s; width: auto;">
                    All
                  </button>
                  <button type="button" class="gender-btn" id="gender-btn-female" onclick="filterDoctorsByGender('Female')" style="padding: 0.3rem 0.8rem; font-size: 0.78rem; font-weight: 700; border-radius: 6px; border: 1px solid var(--border); background: white; color: var(--text-secondary); cursor: pointer; transition: all 0.2s; width: auto;">
                    Female 👩‍⚕️
                  </button>
                  <button type="button" class="gender-btn" id="gender-btn-male" onclick="filterDoctorsByGender('Male')" style="padding: 0.3rem 0.8rem; font-size: 0.78rem; font-weight: 700; border-radius: 6px; border: 1px solid var(--border); background: white; color: var(--text-secondary); cursor: pointer; transition: all 0.2s; width: auto;">
