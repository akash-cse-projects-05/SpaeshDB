        transform: rotateY(0deg) rotateX(0deg) translateY(-8px) scale(1.02);
        border-color: rgba(13, 148, 136, 0.35) !important;
        box-shadow: 0 30px 60px -15px rgba(13, 148, 136, 0.2) !important;
        z-index: 10;
      }
    </style>

    <script>
      // Tab Switching
      const tabs = document.querySelectorAll('.navigation-tab');
      const panels = document.querySelectorAll('.dashboard-panel');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const panelId = tab.dataset.panel;
          switchPanel(panelId);
        });
      });

      function switchPanel(panelId) {
        tabs.forEach(t => {
          const isActive = t.dataset.panel === panelId;
          t.classList.toggle('active', isActive);
          t.style.borderBottom = isActive ? '2px solid var(--primary)' : '2px solid transparent';
          t.style.color = isActive ? 'var(--text)' : 'var(--text-secondary)';
          t.style.fontWeight = isActive ? '600' : '500';
        });
        panels.forEach(p => {
          const isTarget = p.id === panelId;
          p.style.display = isTarget ? 'block' : 'none';
          p.classList.toggle('active', isTarget);
        });
      }

      // Set default panel view states on load
      document.addEventListener('DOMContentLoaded', () => {
        switchPanel('appointments-panel');
      });

      // WIZARD CODE
      let currentStep = 1;
      const totalSteps = 4;
      let selectedService = '';
      let selectedDoctorId = '';
      let selectedDoctorName = '';
      let selectedFee = 400;
      let selectedDate = '';
      let selectedTime = '';

      function selectService(service) {
        selectedService = service;
        document.getElementById('hidden-service-type').value = service;
        document.querySelectorAll('.service-card').forEach(c => c.classList.remove('selected'));
        document.querySelector(`.service-card[data-service="${service}"]`).classList.add('selected');
        document.getElementById('display-selected-service').textContent = service;
        setTimeout(() => moveStep(1), 300);
      }

      function selectDoctor(docId, docName, fee) {
        selectedDoctorId = docId;
        selectedDoctorName = docName;
        selectedFee = fee;

        document.getElementById('hidden-doctor-id').value = docId;
        document.getElementById('hidden-amount').value = fee;

        document.querySelectorAll('.doctor-select-card').forEach(c => c.classList.remove('selected'));
        const docCard = document.querySelector(`.doctor-select-card[data-id="${docId}"]`);
        if (!docCard) return;

        docCard.classList.add('selected');
        const availabilityString = docCard.getAttribute('data-availability');
        const daysContainer = document.getElementById('doctor-availability-days');
        daysContainer.innerHTML = '';

        if (availabilityString) {
          const availabilities = JSON.parse(availabilityString);
          const openSlots = availabilities.filter(s => !s.isBooked);
          if (openSlots.length === 0) {
            daysContainer.innerHTML = '<div style="color: var(--text-muted); font-size: 0.9rem; padding: 1rem; text-align: center; border: 1px dashed var(--border); border-radius: 10px; width: 100%;">No open slots currently available for this doctor.</div>';
          } else {
            openSlots.forEach(slot => {
              const dateStr = slot.date.split('T')[0];
              const btn = document.createElement('div');
              btn.className = 'slot-pill';
              btn.innerHTML = `<span style="font-weight: 700;">📅 ${dateStr}</span> &nbsp;|&nbsp; 🕒 ${slot.time}`;
              btn.onclick = function (e) {
                e.stopPropagation();
                document.querySelectorAll('.slot-pill').forEach(b => b.classList.remove('selected'));
                btn.classList.add('selected');
                selectedDate = dateStr;
                selectedTime = slot.time;
                document.getElementById('hidden-date').value = selectedDate;
                document.getElementById('hidden-time').value = selectedTime;
              };
              daysContainer.appendChild(btn);
            });
          }
        }

        document.getElementById('display-doc-name').textContent = docName;
        moveStep(1);
      }

      // Mode card selection
      document.querySelectorAll('.mode-card').forEach(card => {
        card.addEventListener('click', () => {
          document.querySelectorAll('.mode-card').forEach(c => c.classList.remove('selected-mode'));
          card.classList.add('selected-mode');
          card.querySelector('input[type="radio"]').checked = true;
        });
      });

      function moveStep(direction) {
        if (direction === 1) {
          if (currentStep === 1) {
            if (!selectedService) {
              showToast('Booking Alert', 'Please select a service first.');
              return;
            }
          }
          if (currentStep === 2 && !selectedDoctorId) {
            showToast('Booking Alert', 'Please choose a specialist.');
            return;
          }
          if (currentStep === 3) {
            if (!selectedDate || !selectedTime) {
              showToast('Booking Alert', 'Please select an available consultation slot.');
              return;
            }
            const selectedMode = document.querySelector('input[name="consultationMode"]:checked').value;
            document.getElementById('summary-service').innerText = selectedService;
            document.getElementById('summary-doctor').innerText = selectedDoctorName;
            document.getElementById('summary-slot').innerText = `${selectedDate} at ${selectedTime}`;
            document.getElementById('summary-mode').innerText = selectedMode;
            document.getElementById('summary-email').innerText = document.getElementById('hidden-contact-value').value || '<%= currentUser.email %>';
            document.getElementById('summary-fee').innerText = `₹${selectedFee}`;

            // Check if patient selected a different doctor than their primary doctor
            const primaryDocId = '<%= currentUser.primaryDoctorId ? currentUser.primaryDoctorId._id.toString() : "" %>';
            const warningBox = document.getElementById('continuity-warning');
            if (warningBox) {
              if (primaryDocId && primaryDocId !== selectedDoctorId) {
                warningBox.style.display = 'flex';
              } else {
                warningBox.style.display = 'none';
              }
            }
          }
        }

        document.getElementById(`wizard-step-${currentStep}`).style.display = 'none';
        currentStep += direction;
        document.getElementById(`wizard-step-${currentStep}`).style.display = 'block';
        updateStepperUI();
      }

      function updateStepperUI() {
        const titles = [
          "Step 1 of 4 — Select Service",
          "Step 2 of 4 — Choose Specialist",
          "Step 3 of 4 — Pick Time Slot & Mode",
          "Step 4 of 4 — Review & Confirm"
        ];
        document.getElementById('step-subtitle').innerText = titles[currentStep - 1];

        for (let i = 1; i <= totalSteps; i++) {
          const stepEl = document.getElementById(`progress-${i}`);
          stepEl.classList.remove('active', 'completed');
          if (i === currentStep) stepEl.classList.add('active');
          else if (i < currentStep) stepEl.classList.add('completed');
        }
        for (let i = 1; i < totalSteps; i++) {
          document.getElementById(`progress-line-${i}`).classList.toggle('active', i < currentStep);
        }

        const prevBtn = document.getElementById('prev-btn');
        const nextBtn = document.getElementById('next-btn');
        const submitBtn = document.getElementById('submit-btn');

        prevBtn.style.display = currentStep > 1 ? 'inline-flex' : 'none';
        if (currentStep === totalSteps) {
          nextBtn.style.display = 'none';
          submitBtn.style.display = 'inline-flex';
        } else {
          nextBtn.style.display = currentStep === 3 ? 'inline-flex' : 'none';
          submitBtn.style.display = 'none';
        }
      }

      // Countdown Timer Logic
      const timerEl = document.getElementById('countdown-timer');
      if (timerEl) {
        const targetDate = new Date(timerEl.dataset.target).getTime();
        
        setInterval(() => {
          const now = new Date().getTime();
          const distance = targetDate - now;
          
          if (distance < 0) {
            timerEl.innerHTML = "00:00:00";
            return;
          }
          
          const hours = Math.floor(distance / (1000 * 60 * 60));
          const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((distance % (1000 * 60)) / 1000);
          
          timerEl.innerHTML = 
            (hours < 10 ? "0" + hours : hours) + ":" + 
            (minutes < 10 ? "0" + minutes : minutes) + ":" + 
            (seconds < 10 ? "0" + seconds : seconds);
        }, 1000);
      }

      // PEP Exposure Countdown Timer Logic
      const pepTimerEl = document.getElementById('pep-countdown-timer');
      if (pepTimerEl) {
        const targetDate = new Date(pepTimerEl.dataset.end).getTime();
        
        setInterval(() => {
          const now = new Date().getTime();
          const distance = targetDate - now;
          
          if (distance < 0) {
            pepTimerEl.innerHTML = "EXPIRED";
            pepTimerEl.style.color = "#94a3b8";
            return;
          }
          
          const hours = Math.floor(distance / (1000 * 60 * 60));
          const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((distance % (1000 * 60)) / 1000);
          
          pepTimerEl.innerHTML = 
            (hours < 10 ? "0" + hours : hours) + ":" + 
            (minutes < 10 ? "0" + minutes : minutes) + ":" + 
            (seconds < 10 ? "0" + seconds : seconds);
        }, 1000);
      }

      function showToast(title, msg) {
        let container = document.querySelector('.toast-container');
        if (!container) {
          container = document.createElement('div');
          container.className = 'toast-container';
          document.body.appendChild(container);
        }
        if (!document.getElementById('toast-animation-styles')) {
          const style = document.createElement('style');
          style.id = 'toast-animation-styles';
          style.innerHTML = `
            @keyframes toastOut {
              from { opacity: 1; transform: translateX(0); }
              to   { opacity: 0; transform: translateX(20px); }
            }
          `;
          document.head.appendChild(style);
        }
        const toast = document.createElement('div');
        toast.className = 'toast';
        toast.innerHTML = `
          <div class="toast-title">${title}</div>
          <div class="toast-msg">${msg}</div>
        `;
        container.appendChild(toast);
        setTimeout(() => {
          toast.style.animation = 'toastOut 0.3s ease forwards';
          toast.addEventListener('animationend', () => toast.remove());
        }, 3000);
      }

      // Filter doctors list by gender
      function filterDoctorsByGender(gender) {
        // 1. Reset button styles
        const buttons = {
          'all': document.getElementById('gender-btn-all'),
          'Female': document.getElementById('gender-btn-female'),
          'Male': document.getElementById('gender-btn-male')
        };

        Object.keys(buttons).forEach(key => {
          const btn = buttons[key];
          if (!btn) return;
          if (key === gender) {
            btn.style.background = 'var(--primary)';
            btn.style.color = 'white';
            btn.style.borderColor = 'var(--primary)';
          } else {
            btn.style.background = 'white';
            btn.style.color = 'var(--text-secondary)';
            btn.style.borderColor = 'var(--border)';
          }
        });

        // 2. Hide/show cards
        let visibleCount = 0;
        document.querySelectorAll('.doctor-select-card').forEach(card => {
          const docGender = card.getAttribute('data-gender');
          if (gender === 'all' || docGender === gender) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        // 3. Handle empty state if no doctors fit
        const container = document.getElementById('doctors-container');
        let emptyMsg = document.getElementById('gender-empty-message');
        if (visibleCount === 0) {
          if (!emptyMsg) {
            emptyMsg = document.createElement('div');
            emptyMsg.id = 'gender-empty-message';
            emptyMsg.style = 'color: var(--text-muted); font-size: 0.9rem; padding: 2rem; text-align: center; border: 1px dashed var(--border); border-radius: 12px; width: 100%;';
            emptyMsg.innerText = 'No specialists of the selected gender are currently registered.';
            container.appendChild(emptyMsg);
          } else {
            emptyMsg.style.display = 'block';
          }
        } else if (emptyMsg) {
          emptyMsg.style.display = 'none';
        }
      }
    </script>

