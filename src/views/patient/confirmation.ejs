<%- include('../partials/header') %>

<section style="display: flex; align-items: center; justify-content: center; min-height: 60vh; padding: 2rem 1rem;">
  <div class="card-premium" style="max-width: 550px; width: 100%; text-align: center; border-radius: 16px;">
    
    <!-- Success Icon -->
    <div style="width: 72px; height: 72px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), #0f766e); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    
    <p style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--primary); margin-bottom: 0.5rem;">Booking Confirmed</p>
    <h1 style="font-size: 1.75rem; font-weight: 800; color: var(--text); margin-bottom: 0.75rem;">Appointment Booked!</h1>
    <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; max-width: 420px; margin: 0 auto 2rem;">
      Your consultation request has been submitted successfully. We will send confirmation updates to
      <strong style="color: var(--text);"><%= appointment.patientContact.value %></strong>.
    </p>

    <!-- Appointment Summary -->
    <div style="background: var(--bg); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; text-align: left; margin-bottom: 2rem;">
      <div class="summary-row">
        <span>Consultation</span>
        <strong><%= appointment.consultationType %></strong>
      </div>
      <div class="summary-row">
        <span>Doctor</span>
        <strong><%= appointment.doctorId ? appointment.doctorId.name : 'N/A' %></strong>
      </div>
      <div class="summary-row">
        <span>Date & Time</span>
        <strong>
          <% 
            let displayDate = 'N/A';
            let displayTime = 'N/A';
            if (appointment.appointmentSlot && appointment.appointmentSlot.date) {
              try {
                if (appointment.appointmentSlot.date instanceof Date) {
                  displayDate = appointment.appointmentSlot.date.toISOString().split('T')[0];
                } else {
                  displayDate = new Date(appointment.appointmentSlot.date).toISOString().split('T')[0];
                }
              } catch (e) {
                displayDate = appointment.appointmentSlot.date.toString();
              }
              displayTime = appointment.appointmentSlot.time;
            } else if (appointment.date) {
              displayDate = appointment.date;
              displayTime = appointment.time;
            }
          %>
          📅 <%= displayDate %> at 🕒 <%= displayTime %>
        </strong>
      </div>
      <div class="summary-row" style="border-bottom: none;">
        <span>Mode</span>
        <strong><%= appointment.consultationMode %></strong>
      </div>
    </div>

    <a href="/patient/dashboard" class="btn btn-primary" style="padding: 0.7rem 2rem; font-weight: 700; border-radius: 10px;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right: 0.35rem;"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      Back to My Portal
    </a>
  </div>
</section>

<style>
  .summary-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 1rem 1.25rem; border-bottom: 1px solid var(--border);
  }
  .summary-row span { color: var(--text-secondary); font-size: 0.88rem; }
  .summary-row strong { color: var(--text); font-size: 0.92rem; }
</style>

<%- include('../partials/footer') %>
