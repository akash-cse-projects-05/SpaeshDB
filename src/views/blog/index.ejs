<%- include('../partials/header') %>

<div class="airbnb-layout" style="padding: 3rem 1rem;">
  <div style="text-align: center; margin-bottom: 4rem;">
    <h1 style="font-size: 2.8rem; margin-bottom: 1rem; font-weight: 800;">Resource &amp; Medical Blog</h1>
    <p style="color: var(--airbnb-text-secondary); max-width: 600px; margin: 0 auto; font-size: 1.15rem;">
      Stay informed with medically reviewed articles covering safety protocols, viral updates, and emotional wellness strategies.
    </p>
  </div>

  <% if (articles && articles.length > 0) { %>
    <div class="blog-grid">
      <% articles.forEach(article => { %>
        <article class="blog-card" onclick="window.location.href='/blog/<%= article.slug %>'">
          <div class="blog-card-img-placeholder">
            <% if (article.category === 'PEP') { %>
              <div style="display: flex; flex-direction: column; align-items: center; gap: 0.5rem;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <span style="font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; color: var(--primary);">PEP PATHWAY</span>
              </div>
            <% } else if (article.category === 'PrEP') { %>
              <div style="display: flex; flex-direction: column; align-items: center; gap: 0.5rem; color: #3b82f6;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                <span style="font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; color: #3b82f6;">PrEP ROUTINE</span>
              </div>
            <% } else { %>
              <div style="display: flex; flex-direction: column; align-items: center; gap: 0.5rem; color: #10b981;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                <span style="font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; color: #10b981;">WELLNESS</span>
              </div>
            <% } %>
          </div>
          
          <div class="blog-card-body">
            <div class="blog-card-meta">
              <span class="badge <%= article.category === 'PEP' ? 'badge-pep' : (article.category === 'PrEP' ? 'badge-prep' : 'badge-general') %>">
                <%= article.category %>
              </span>
              <span>&bull;</span>
              <span>
                <%= new Date(article.createdAt).toLocaleDateString(undefined, {month: 'short', day: 'numeric', year: 'numeric'}) %>
              </span>
            </div>
            
            <h3 class="blog-card-title"><%= article.title %></h3>
            
            <p class="blog-card-excerpt">
              <%= article.summary %>
            </p>
            
            <div class="blog-card-footer">
              <span class="blog-card-author">
                By <%= article.author.split(',')[0] %>
              </span>
              <a href="/blog/<%= article.slug %>" class="blog-card-link" onclick="event.stopPropagation();">
                Read Article <span style="font-size: 1.1rem; line-height: 1;">&rarr;</span>
              </a>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <div style="text-align: center; padding: 6rem 2rem; border: 1px dashed var(--airbnb-border); border-radius: 16px;">
      <p style="color: var(--airbnb-text-secondary); font-size: 1.1rem;">No blog articles found. Please check back later.</p>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
