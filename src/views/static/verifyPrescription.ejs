<%- include('../partials/header') %>

<div style="max-width: 550px; margin: 3rem auto; padding: 0 1rem;">
  
  <div class="card-premium" style="border-radius: 16px; padding: 2.5rem; text-align: center;">
    
    <div style="width: 60px; height: 60px; background: rgba(13, 148, 136, 0.08); color: var(--primary); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 1.6rem; margin-bottom: 1.5rem;">
      🛡️
    </div>

    <h2 style="font-size: 1.65rem; font-weight: 800; color: var(--text); margin-bottom: 0.5rem; letter-spacing: -0.01em;">Prescription Verification</h2>
    <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 2rem;">Secure cryptographic access log for pharmacy fulfillment.</p>

    <% if (!verified) { %>
      <!-- PIN Entry Form -->
      <form action="/prescription/verify/<%= appointmentId %>" method="POST" style="display: flex; flex-direction: column; gap: 1.25rem; max-width: 320px; margin: 0 auto; text-align: left;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        
        <div class="form-group" style="display: flex; flex-direction: column; gap: 0.4rem;">
          <label for="pin" style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); text-align: center; display: block; width: 100%;">
            Enter 4-Digit Access PIN
          </label>
          <input type="password" name="pin" id="pin" maxlength="4" required class="form-control" placeholder="••••" style="text-align: center; font-size: 1.8rem; font-weight: 800; letter-spacing: 0.5rem; padding: 0.5rem; border-radius: 8px; font-family: monospace;" autofocus>
        </div>

        <% if (error && error.length) { %>
          <div style="color: #ef4444; font-size: 0.85rem; font-weight: 600; text-align: center;">
            ❌ <%= error %>
          </div>
        <% } %>

        <button type="submit" class="btn btn-primary" style="padding: 0.75rem 2rem; font-weight: 700; font-size: 1rem; border-radius: 8px; width: 100%; margin-top: 0.5rem;">
          Verify Prescription
        </button>
      </form>
    <% } else { %>
      <!-- Verified Content Display -->
      <div style="background: rgba(34, 197, 94, 0.05); border: 2px solid #22c55e; border-radius: 12px; padding: 0.75rem 1.25rem; display: inline-flex; align-items: center; gap: 0.5rem; margin-bottom: 2rem; color: #15803d; font-weight: 700; font-size: 0.9rem;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        VERIFIED MEDICAL RECORD
      </div>

      <div style="text-align: left; background: var(--bg); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 2rem;">
        <div>
          <strong style="color: var(--text-secondary); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.15rem;">Prescribing Practitioner</strong>
          <span style="color: var(--text); font-weight: 700; font-size: 1.05rem;">
            Dr. <%= appointment.doctorId ? appointment.doctorId.name : appointment.doctorName %>
          </span>
          <span style="color: var(--text-secondary); font-size: 0.82rem; display: block;">
            <%= appointment.doctorId ? appointment.doctorId.qualification : 'Verified Consultant' %> · Specialty: <%= appointment.consultationType %>
          </span>
        </div>

        <div>
          <strong style="color: var(--text-secondary); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.15rem;">Patient Identity</strong>
          <span style="color: var(--text); font-weight: 700;">
            <% if (appointment.isAnonymous) { %>
              🔒 Masked Anonymous Patient (ID: <%= appointment._id.toString().slice(-6).toUpperCase() %>)
            <% } else { %>
              👤 <%= appointment.patientId ? appointment.patientId.name : appointment.patientName %>
            <% } %>
          </span>
        </div>

        <div style="border-top: 1px solid var(--border); padding-top: 1rem;">
          <strong style="color: var(--text-secondary); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.35rem;">Prescribed Medication</strong>
          <div style="background: rgba(13, 148, 136, 0.04); border: 1px solid rgba(13, 148, 136, 0.15); padding: 1rem; border-radius: 8px;">
            <p style="margin: 0 0 0.5rem 0; font-size: 1rem; font-weight: 700; color: var(--primary);"><%= appointment.prescription.medication %></p>
            <p style="margin: 0; font-size: 0.85rem; color: var(--text-secondary); font-weight: 600;"><span style="color: var(--text); font-weight: 700;">Dosage:</span> <%= appointment.prescription.dosage %></p>
          </div>
        </div>

        <% if (appointment.prescription.notes) { %>
          <div>
            <strong style="color: var(--text-secondary); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.25rem;">Pharmacist Directives</strong>
            <p style="margin: 0; font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5; white-space: pre-wrap;"><%= appointment.prescription.notes %></p>
          </div>
        <% } %>

        <div style="border-top: 1px solid var(--border); padding-top: 0.75rem; display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-muted);">
          <span>Fulfillment Code: <%= appointment.paymentDetails ? appointment.paymentDetails.transactionId : 'N/A' %></span>
          <span>Issued: <%= new Date(appointment.prescription.updatedAt).toLocaleDateString() %></span>
        </div>
      </div>

      <p style="font-size: 0.8rem; color: var(--text-secondary); margin: 0;">
        This document represents an active verification credential issued by Sparsh Touch of Care. For queries, contact support@sparsh.org.
      </p>
    <% } %>

  </div>
</div>

<%- include('../partials/footer') %>
