<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Sparsh – Secure Consultation Room' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #031412;
      --panel-bg: #092a26;
      --text: #f8fafc;
      --primary: #2dd4bf;
      --danger: #ef4444;
    }
    body, html {
      margin: 0; padding: 0;
      height: 100%; width: 100%;
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      overflow: hidden;
    }
    .room-container {
      display: flex;
      flex-direction: column;
      height: 100vh;
    }
    .room-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 1.5rem;
      background: rgba(9, 42, 38, 0.8);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(45, 212, 191, 0.2);
    }
    .room-header .logo {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--primary);
    }
    .room-header .badges {
      display: flex;
      gap: 1rem;
    }
    .badge {
      background: rgba(255,255,255,0.1);
      padding: 0.25rem 0.75rem;
      border-radius: 20px;
      font-size: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .badge.encrypted { color: #86efac; }
    .badge.time { font-family: monospace; }
    
    .video-grid {
      flex: 1;
      display: flex;
      padding: 1.5rem;
      gap: 1.5rem;
      justify-content: center;
      align-items: center;
    }
    .video-frame {
      background: var(--panel-bg);
      border-radius: 16px;
      overflow: hidden;
      position: relative;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      border: 1px solid rgba(255,255,255,0.05);
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .main-video {
      flex: 2;
      height: 100%;
      max-height: calc(100vh - 180px);
    }
    .self-video {
      position: absolute;
      bottom: 20px;
      right: 20px;
      width: 240px;
      height: 160px;
      border: 2px solid rgba(255,255,255,0.2);
      border-radius: 12px;
      z-index: 10;
      background: #000;
    }
    
    .video-overlay-text {
      position: absolute;
      bottom: 15px;
      left: 15px;
      background: rgba(0,0,0,0.6);
      padding: 0.25rem 0.75rem;
      border-radius: 6px;
      font-size: 0.85rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .video-overlay-text .dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--primary);
      box-shadow: 0 0 8px var(--primary);
    }

    .placeholder-icon {
      color: rgba(255,255,255,0.2);
    }

    .controls-bar {
      height: 80px;
      background: rgba(9, 42, 38, 0.9);
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1.5rem;
      border-top: 1px solid rgba(255,255,255,0.1);
    }
    .control-btn {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: rgba(255,255,255,0.1);
      border: none;
      color: #fff;
      display: flex;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      transition: all 0.2s;
    }
    .control-btn:hover { background: rgba(255,255,255,0.2); transform: scale(1.05); }
    .control-btn.end-call {
      background: var(--danger);
      width: auto;
      padding: 0 1.5rem;
      border-radius: 25px;
      font-weight: 600;
      gap: 0.5rem;
    }
    .control-btn.end-call:hover { background: #dc2626; }
    .control-btn.muted {
      background: rgba(239, 68, 68, 0.2);
      color: #fca5a5;
    }

    /* Mobile Responsive Optimizations for Telehealth Consultation Room */
    @media (max-width: 640px) {
      .room-header {
        padding: 0.75rem 1rem;
      }
      .room-header .logo {
        font-size: 0.95rem;
      }
      .video-grid {
        padding: 0.75rem;
      }
      .self-video {
        width: 110px;
        height: 75px;
        bottom: 10px;
        right: 10px;
        border-width: 1.5px;
        border-radius: 8px;
      }
      .controls-bar {
        height: 70px;
        gap: 0.75rem;
        padding: 0 0.5rem;
      }
      .control-btn {
        width: 44px;
        height: 44px;
      }
      .control-btn.end-call {
        padding: 0 1rem;
        font-size: 0.82rem;
      }
    }
  </style>
</head>
<body>
  <div class="room-container">
    <header class="room-header">
      <div class="logo">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Sparsh Secure Room
      </div>
      <div class="badges">
        <div class="badge encrypted">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          E2E Encrypted
        </div>
        <div class="badge time" id="call-timer">00:00</div>
      </div>
    </header>

    <main class="video-grid">
      <div class="video-frame main-video">
        <svg class="placeholder-icon" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><circle cx="12" cy="7" r="4"/><path d="M5.5 21a6.5 6.5 0 0113 0"/></svg>
        <div class="video-overlay-text">
          <div class="dot"></div>
          <%= currentUser && currentUser.role === 'doctor' ? 'Patient (Anonymous)' : 'Dr. Alok Sharma' %>
        </div>

        <div class="video-frame self-video">
          <svg class="placeholder-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><circle cx="12" cy="7" r="4"/><path d="M5.5 21a6.5 6.5 0 0113 0"/></svg>
          <div class="video-overlay-text" style="font-size: 0.7rem; bottom: 8px; left: 8px;">
            You
          </div>
        </div>
      </div>
    </main>

    <footer class="controls-bar">
      <button class="control-btn" title="Toggle Microphone">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
      </button>
      <button class="control-btn" title="Toggle Camera">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
      </button>
      <button class="control-btn" title="Share Screen">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
      </button>
      <a href="javascript:history.back()" class="control-btn end-call" style="text-decoration: none;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.68 13.31a16 16 0 0 0 3.41 2.6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7 2 2 0 0 1 1.72 2v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.42 19.42 0 0 1-3.33-2.67m-2.67-3.34a19.79 19.79 0 0 1-3.07-8.63A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91"/></svg>
        Leave Room
      </a>
    </footer>
  </div>

  <script>
    // Simple call timer
    let seconds = 0;
    setInterval(() => {
      seconds++;
      const m = Math.floor(seconds / 60).toString().padStart(2, '0');
      const s = (seconds % 60).toString().padStart(2, '0');
      document.getElementById('call-timer').textContent = `${m}:${s}`;
    }, 1000);
  </script>
</body>
</html>
