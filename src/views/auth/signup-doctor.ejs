<%- include('../partials/header') %>

<div style="max-width: 480px; margin: 2rem auto; text-align: center;">
  <div class="card">
    <h2 style="font-size: 1.8rem; margin-bottom: 0.5rem; color: var(--text);">Doctor Registration</h2>
    <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 2rem;">
      Register as a verified clinical partner or health counselor on Sparsh.
    </p>

    <form action="/auth/signup/doctor?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="name">Doctor / Consultant Name</label>
        <input type="text" name="name" id="name" class="form-control" placeholder="e.g. Dr. Jane Smith" required>
      </div>

      <div class="form-group">
        <label for="email">Professional Email</label>
        <input type="email" name="email" id="email" class="form-control" placeholder="e.g. janesmith@hospital.com" required>
      </div>

      <div class="form-group">
        <label for="specialization">Medical Specialization</label>
        <select name="specialization" id="specialization" class="form-control" required>
          <option value="">-- Select Speciality --</option>
          <option value="Infectious Disease Specialist">Infectious Disease Specialist</option>
          <option value="General Physician">General Physician / MD</option>
          <option value="HIV/AIDS Counsellor">HIV/AIDS Counsellor</option>
          <option value="Sexual Health Consultant">Sexual Health Consultant</option>
        </select>
      </div>

      <div class="form-group">
        <label for="gender">Gender</label>
        <select name="gender" id="gender" class="form-control" required>
          <option value="">-- Select Gender --</option>
          <option value="Male">Male</option>
          <option value="Female">Female</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <div class="form-group">
        <label for="qualification">Qualifications / Credentials</label>
        <input type="text" name="qualification" id="qualification" class="form-control" placeholder="e.g. MBBS, MD (Infectious Diseases)" required>
      </div>

      <div class="form-group">
        <label for="phoneNumber">Contact Number</label>
        <input type="tel" name="phoneNumber" id="phoneNumber" class="form-control" placeholder="e.g. +91 99999 88888" required>
      </div>

      <div class="form-group">
        <label for="consultationFee">Consultation Fee (₹)</label>
        <input type="number" name="consultationFee" id="consultationFee" class="form-control" placeholder="e.g. 500" min="0" required>
      </div>

      <div class="form-group">
        <label for="bio">Professional Bio</label>
        <textarea name="bio" id="bio" class="form-control" placeholder="Brief summary of your medical experience and credentials..." rows="3" required></textarea>
      </div>

      <div class="form-group">
        <label for="resume">Upload Resume/Bio (PDF, DOCX)</label>
        <input type="file" name="resume" id="resume" class="form-control" accept=".pdf,.doc,.docx" required>
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" name="password" id="password" class="form-control" required minlength="6">
      </div>

      <div class="form-group">
        <label for="confirmPassword">Confirm Password</label>
        <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" required minlength="6">
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem; margin-top: 1rem;">
        Submit Verification Credentials
      </button>
    </form>

    <div style="margin-top: 2rem; border-top: 1px solid var(--border); padding-top: 1.5rem; font-size: 0.9rem;">
      <p style="color: var(--text-secondary);">
        Already have an account? <a href="/auth/login" style="color: var(--secondary); font-weight: 500;">Log in here</a>
      </p>
      <p style="color: var(--text-secondary); margin-top: 0.5rem;">
        Seeking clinical support? <a href="/auth/signup/patient" style="color: var(--primary); font-weight: 500;">Register as Patient</a>
      </p>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
