<%- include('../partials/header') %>

<div style="max-width: 480px; margin: 2rem auto; text-align: center;">
  <div class="card">
    <h2 style="font-size: 1.8rem; margin-bottom: 0.5rem; color: var(--text);">Patient Registration</h2>
    <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 2rem;">
      Create your secure Sparsh account to book confidential consultations.
    </p>

    <form action="/auth/signup/patient" method="POST" id="signup-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-check" style="background: var(--primary-bg); border: 1px solid #99f6e4; padding: 0.75rem 1rem; border-radius: 8px;">
        <input type="checkbox" name="isAnonymous" id="isAnonymous" value="true">
        <label for="isAnonymous" style="cursor: pointer; font-size: 0.9rem; font-weight: 600; color: var(--secondary);">
          🔒 Stay Anonymous (Hide My Real Name)
        </label>
      </div>

      <div class="form-group" id="patient-name-group">
        <label for="name">Full Name</label>
        <input type="text" name="name" id="name" class="form-control" placeholder="e.g. John Doe" required>
      </div>

      <div class="form-group">
        <label for="email">Email Address</label>
        <input type="email" name="email" id="email" class="form-control" placeholder="e.g. john@example.com" required>
        <span style="font-size: 0.75rem; color: var(--text-muted); display: block; margin-top: 0.25rem;">We encrypt all emails. They are never shared publicly.</span>
      </div>

      <div class="grid-2" style="gap: 1rem; margin-bottom: 0;">
        <div class="form-group">
          <label for="age">Age</label>
          <input type="number" name="age" id="age" class="form-control" min="1" max="120" required>
        </div>
        <div class="form-group">
          <label for="contact">Contact Number</label>
          <input type="text" name="contact" id="contact" class="form-control" placeholder="e.g. +91 9988776655" required>
        </div>
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" name="password" id="password" class="form-control" required minlength="6">
      </div>

      <div class="form-group">
        <label for="confirmPassword">Confirm Password</label>
        <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" required minlength="6">
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem; margin-top: 1rem;">
        Register & Continue
      </button>
    </form>

    <div style="margin-top: 2rem; border-top: 1px solid var(--border); padding-top: 1.5rem; font-size: 0.9rem;">
      <p style="color: var(--text-secondary);">
        Already have an account? <a href="/auth/login" style="color: var(--secondary); font-weight: 500;">Log in here</a>
      </p>
      <p style="color: var(--text-secondary); margin-top: 0.5rem;">
        Are you a medical practitioner? <a href="/auth/signup/doctor" style="color: var(--primary); font-weight: 500;">Join as Partner Doctor</a>
      </p>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
