<%- include('../partials/header') %>

<div style="max-width: 480px; margin: 2.5rem auto;">

  <div style="text-align: center; margin-bottom: 1.75rem;">
    <div class="logo-icon" style="width:48px;height:48px;font-size:1.3rem;margin:0 auto 1rem;">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
    </div>
    <h1 style="font-size:1.6rem;font-weight:700;">Welcome to Sparsh</h1>
    <p style="font-size:0.875rem;color:var(--text-secondary);margin-top:0.25rem;">Sign in or create an account</p>
  </div>

  <div class="card" style="padding: 2rem;">

    <div class="tabs" style="margin-bottom: 1.75rem; width: 100%;">
      <button class="tab-btn active" style="flex:1; cursor: default;">Login</button>
    </div>

    <!-- ── LOGIN FORM ── -->
    <div id="panel-login">
      <form action="/auth/login/patient" method="POST" id="login-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="login-email">Email</label>
          <div class="input-wrapper">
            <span class="input-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </span>
            <input type="email" name="email" id="login-email" class="form-control has-icon" placeholder="you@example.com" required>
          </div>
        </div>

        <div class="form-group">
          <label for="login-password">Password</label>
          <div class="input-wrapper">
            <span class="input-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            </span>
            <input type="password" name="password" id="login-password" class="form-control has-icon" placeholder="••••••••" required>
          </div>
        </div>

        <div class="form-group">
          <label>I am a</label>
          <div class="radio-group">
            <label class="radio-option">
              <input type="radio" name="role" value="patient" checked onchange="updateLoginAction(this)"> Patient
            </label>
            <label class="radio-option">
              <input type="radio" name="role" value="doctor" onchange="updateLoginAction(this)"> Doctor
            </label>
            <label class="radio-option">
              <input type="radio" name="role" value="admin" onchange="updateLoginAction(this)"> Admin
            </label>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-full btn-lg" style="margin-top:0.5rem;">Sign In</button>
      </form>
    </div>

    <div style="margin-top: 2rem; border-top: 1px solid var(--border); padding-top: 1.5rem; font-size: 0.9rem; text-align: center;">
      <p style="color: var(--text-secondary);">
        Don't have an account? 
        <br><br>
        <a href="/auth/signup/patient" style="color: var(--secondary); font-weight: 500; display: inline-block; margin-right: 15px;">Register as Patient</a>
        <a href="/auth/signup/doctor" style="color: var(--primary); font-weight: 500; display: inline-block;">Register as Doctor</a>
      </p>
    </div>

  </div>
</div>

<script>
function updateLoginAction(radio) {
  const form = document.getElementById('login-form');
  if (radio.value === 'doctor') form.action = '/auth/login/doctor';
  else if (radio.value === 'admin') form.action = '/auth/login/patient';
  else form.action = '/auth/login/patient';
}
</script>

<%- include('../partials/footer') %>
