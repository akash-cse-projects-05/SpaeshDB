<%- include('../partials/header') %>

<div style="margin-bottom: 2.5rem;">
  <% if (role === 'doctor') { %>
    <a href="/doctor/dashboard" style="color: var(--primary); font-weight: 600; display: inline-flex; align-items: center; gap: 0.35rem;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      Return to Doctor Dashboard
    </a>
  <% } else if (role === 'admin') { %>
    <a href="/admin/dashboard" style="color: var(--primary); font-weight: 600; display: inline-flex; align-items: center; gap: 0.35rem;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      Return to Admin Dashboard
    </a>
  <% } else { %>
    <a href="/patient/dashboard" style="color: var(--primary); font-weight: 600; display: inline-flex; align-items: center; gap: 0.35rem;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      Return to My Portal
    </a>
  <% } %>
</div>

<% if (appointment.status === 'Pending') { %>
  <div class="card-premium" style="margin-bottom: 2rem; border-color: #f59e0b; background: rgba(245, 158, 11, 0.03); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding: 1.25rem 1.5rem;">
    <div style="flex: 1; min-width: 250px;">
      <h4 style="color: #d97706; font-size: 1.1rem; margin-bottom: 0.25rem; font-weight: 700; display: flex; align-items: center; gap: 0.35rem;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        Pending Practitioner Confirmation
      </h4>
      <% if (role === 'doctor') { %>
        <p style="font-size: 0.88rem; color: var(--text-secondary); margin: 0;">This appointment request is pending your schedule review. Please confirm or decline the slot.</p>
      <% } else { %>
        <p style="font-size: 0.88rem; color: var(--text-secondary); margin: 0;">Your consultant is reviewing the slot request. You will be notified once confirmed.</p>
      <% } %>
    </div>
    <% if (role === 'doctor' || role === 'admin') { %>
      <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
        <form action="/appointments/<%= appointment._id %>/status" method="POST" style="margin:0;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="status" value="Confirmed">
          <button type="submit" class="btn btn-primary" style="font-size: 0.85rem; padding: 0.5rem 1.25rem; font-weight: 700;">Confirm Slot</button>
        </form>
        <form action="/appointments/<%= appointment._id %>/cancel" method="POST" style="margin:0;" onsubmit="return confirm('Reject this appointment request?');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-secondary" style="font-size: 0.85rem; padding: 0.5rem 1.25rem; color: #dc2626; border-color: rgba(220,38,38,0.2);">Decline</button>
        </form>
      </div>
    <% } %>
  </div>
<% } %>

<div class="panel-container">
  
  <!-- Left Side: Clinical File Details -->
  <div style="display: flex; flex-direction: column; gap: 1.5rem;">
    
    <!-- AI Clinical Risk Score & Triage Analyzer Widget -->
    <div class="card-premium" style="border-radius: 14px; padding: 1.25rem; background: linear-gradient(135deg, rgba(15, 23, 42, 0.02) 0%, rgba(13, 148, 136, 0.04) 100%); border: 1px solid var(--border);">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
        <h3 style="margin: 0; font-size: 0.95rem; font-weight: 800; color: var(--text); display: flex; align-items: center; gap: 0.4rem;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="color: var(--primary);"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          AI Clinical Triage Risk Analyzer
        </h3>
        <% if (appointment.consultationType === 'PEP') { %>
          <span style="font-size: 0.72rem; font-weight: 800; background: rgba(220, 38, 38, 0.12); color: #dc2626; padding: 0.2rem 0.6rem; border-radius: 6px;">HIGH URGENCY</span>
        <% } else if (appointment.consultationType === 'PrEP') { %>
          <span style="font-size: 0.72rem; font-weight: 800; background: rgba(37, 99, 235, 0.12); color: #2563eb; padding: 0.2rem 0.6rem; border-radius: 6px;">MODERATE</span>
        <% } else { %>
          <span style="font-size: 0.72rem; font-weight: 800; background: rgba(16, 185, 129, 0.12); color: #16a34a; padding: 0.2rem 0.6rem; border-radius: 6px;">STABLE</span>
        <% } %>
      </div>
      <div style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5; background: var(--card-bg); padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border);">
        <% if (appointment.consultationType === 'PEP') { %>
          <strong>Assessment:</strong> Immediate 72-hour window critical for PEP intervention. High priority clinical consultation recommended.
        <% } else if (appointment.consultationType === 'PrEP') { %>
          <strong>Assessment:</strong> Routine pre-exposure prophylaxis evaluation. Verification of quarterly renal & HIV status advised.
        <% } else { %>
          <strong>Assessment:</strong> General preventive consultation and guidance session. Standard clinical protocol.
        <% } %>
      </div>
    </div>

    <div class="card-premium">
      <h3 style="color: var(--text); font-size: 1.25rem; font-weight: 700; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary);"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
        Consultation File
      </h3>
      
      <div style="font-size: 0.9rem; display: flex; flex-direction: column; gap: 1rem;">
        <div>
          <strong style="color: var(--text-secondary); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.25rem;">Care Specialty</strong> 
          <span class="badge <%= appointment.consultationType === 'PEP' ? 'badge-teal' : (appointment.consultationType === 'PrEP' ? 'badge-blue' : 'badge-green') %>" style="font-size: 0.72rem; padding: 0.25rem 0.6rem;">
            <%= appointment.consultationType %>
          </span>
        </div>
        
        <div>
          <strong style="color: var(--text-secondary); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.25rem;">Scheduled Slot</strong>
          <span style="color: var(--text); font-weight: 600; display: inline-flex; align-items: center; gap: 0.25rem;">
            📅 
            <% 
              let displayDate = 'N/A';
              let displayTime = 'N/A';
              if (appointment.appointmentSlot && appointment.appointmentSlot.date) {
                try {
                  if (appointment.appointmentSlot.date instanceof Date) {
                    displayDate = appointment.appointmentSlot.date.toISOString().split('T')[0];
                  } else {
                    displayDate = new Date(appointment.appointmentSlot.date).toISOString().split('T')[0];
                  }
                } catch (e) {
                  displayDate = appointment.appointmentSlot.date.toString();
                }
                displayTime = appointment.appointmentSlot.time;
              } else if (appointment.date) {
                displayDate = appointment.date;
                displayTime = appointment.time;
              }
            %>
            <%= displayDate %> at <%= displayTime %>
          </span>
        </div>
        
        <div>
          <strong style="color: var(--text-secondary); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.25rem;">Physician Specialist</strong>
          <span style="color: var(--text); font-weight: 600;">
            Dr. <%= appointment.doctorId ? `${appointment.doctorId.name.replace(/^Dr\.\s*/i, '')} (${appointment.doctorId.specialization})` : (appointment.doctorName || 'N/A').replace(/^Dr\.\s*/i, '') %>
          </span>
        </div>
        
        <div>
          <strong style="color: var(--text-secondary); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.25rem;">Patient</strong>
          <span style="color: var(--text); font-weight: 600;">
            <% if (appointment.patientId) { %>
              <% if (appointment.patientId.isAnonymous) { %>
                🔒 Anonymous Profile (ID: <%= appointment.patientId._id.toString().slice(-6).toUpperCase() %>)
              <% } else { %>
                👤 <%= appointment.patientId.name %> (Age: <%= appointment.patientId.age %>)
              <% } %>
            <% } else if (appointment.patientName) { %>
              <% if (appointment.isAnonymous) { %>
                🔒 Anonymous Profile (ID: <%= appointment._id.toString().slice(-6).toUpperCase() %>)
              <% } else { %>
                👤 <%= appointment.patientName %>
              <% } %>
            <% } else { %>
              <span style="color: var(--text-muted);">Unknown Patient</span>
            <% } %>
          </span>
        </div>

        <div>
          <strong style="color: var(--text-secondary); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.25rem;">Transaction Code</strong>
          <span style="font-family: monospace; font-size: 0.8rem; color: var(--text-secondary); background: var(--bg); border: 1px solid var(--border); padding: 0.2rem 0.5rem; border-radius: 4px;">
            <%= appointment.paymentDetails ? appointment.paymentDetails.transactionId : 'N/A' %>
          </span>
        </div>

        <div>
          <strong style="color: var(--text-secondary); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.25rem;">File Status</strong> 
          <% 
            let currentStatus = (appointment.status || 'Pending').toLowerCase();
            let badgeClass = 'badge-pending';
            if (currentStatus === 'confirmed' || currentStatus === 'upcoming') badgeClass = 'badge-confirmed';
            else if (currentStatus === 'completed') badgeClass = 'badge-completed';
            else if (currentStatus === 'cancelled') badgeClass = 'badge-cancelled';
          %>
          <span class="badge <%= badgeClass %>" style="font-size: 0.72rem; padding: 0.25rem 0.6rem;">
            <%= appointment.status %>
          </span>
        </div>
      </div>

      <!-- Quick Doctor Actions: Update Status -->
      <% if (role === 'doctor' || role === 'admin') { %>
        <div style="margin-top: 1.5rem; border-top: 1px solid var(--border); padding-top: 1.25rem;">
          <form action="/appointments/<%= appointment._id %>/status" method="POST" style="margin: 0;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-group" style="display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 0;">
              <label for="status" style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary);">Modify File Status</label>
              <select name="status" id="status" class="form-control" style="padding: 0.5rem; font-size: 0.88rem; width: 100%;" onchange="this.form.submit()">
                <option value="Pending" <%= appointment.status === 'Pending' ? 'selected' : '' %>>Pending Review</option>
                <option value="Confirmed" <%= appointment.status === 'Confirmed' ? 'selected' : '' %>>Confirmed</option>
                <option value="Completed" <%= appointment.status === 'Completed' ? 'selected' : '' %>>Completed</option>
                <option value="Cancelled" <%= appointment.status === 'Cancelled' ? 'selected' : '' %>>Cancelled / Rejected</option>
              </select>
            </div>
          </form>
        </div>
      <% } %>
    </div>

    <!-- Anonymous Patient Registration (Doctor Only) -->
    <% if (role === 'doctor' && appointment.patientId && appointment.patientId.isAnonymous) { %>
      <div class="card-premium" style="border-color: var(--primary); background: rgba(13, 148, 136, 0.02);">
        <h3 style="color: var(--primary); font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem; border-bottom: 1px solid rgba(13, 148, 136, 0.15); padding-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
          Register Patient Account
        </h3>
        <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1.25rem;">
          This session was booked anonymously. If the patient agrees, you can convert their profile into a full account to preserve their medical history for future visits. The default password will be <strong>Sparsh@123</strong>.
        </p>

        <form action="/appointments/<%= appointment._id %>/register-patient" method="POST" style="display: flex; flex-direction: column; gap: 1rem;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          
          <div class="form-group" style="display: flex; flex-direction: column; gap: 0.4rem;">
            <label for="name" style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary);">Full Name</label>
            <input type="text" name="name" id="name" class="form-control" required placeholder="Patient's Full Name">
          </div>
          
          <div class="form-group" style="display: flex; gap: 1rem;">
            <div style="flex: 1; display: flex; flex-direction: column; gap: 0.4rem;">
              <label for="email" style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary);">Email Address</label>
              <input type="email" name="email" id="email" class="form-control" required placeholder="Email Address">
            </div>
            <div style="flex: 1; display: flex; flex-direction: column; gap: 0.4rem;">
              <label for="contact" style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary);">Phone Number</label>
              <input type="text" name="contact" id="contact" class="form-control" required placeholder="Contact Number">
            </div>
          </div>
          
          <div class="form-group" style="display: flex; flex-direction: column; gap: 0.4rem;">
            <label for="age" style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary);">Age</label>
            <input type="number" name="age" id="age" class="form-control" required min="0" max="120" placeholder="Patient's Age">
          </div>

          <button type="submit" class="btn btn-primary" style="align-self: flex-start; padding: 0.65rem 1.5rem; font-weight: 700; margin-top: 0.5rem;">
            Create Full Account
          </button>
        </form>
      </div>
    <% } %>

    <!-- Clinical History Notes -->
    <div class="card-premium">
      <h3 style="color: var(--text); font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary);"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
        Symptom Log / Case Notes
      </h3>
      <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.65; white-space: pre-line; margin: 0;">
        <%= appointment.patientHistory || 'No symptom history provided by patient.' %>
      </p>
    </div>

    <!-- Patient PrEP Adherence Tracker (Visible ONLY to the Doctor who assigned the prescription) -->
    <% 
      const isDocWhoPrescribed = (role === 'doctor' && 
                                 appointment.doctorId._id.toString() === currentUser._id.toString() && 
                                 appointment.prescription && 
                                 appointment.prescription.medication);
    %>
    <% if (isDocWhoPrescribed) { %>
      <div class="card-premium" style="margin-top: 2rem;">
        <h3 style="color: var(--text); font-size: 1.25rem; font-weight: 700; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary);"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Patient PrEP Adherence Tracker
        </h3>

        <% if (appointment.patientId && appointment.patientId.prepTracking && appointment.patientId.prepTracking.isActive) { %>
          <!-- Streak and Stat Row -->
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
            <div style="background: var(--bg); border: 1px solid var(--border); padding: 0.85rem; border-radius: 10px; text-align: center;">
              <span style="font-size: 0.7rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block; margin-bottom: 0.25rem;">🔥 Current Streak</span>
              <strong style="font-size: 1.5rem; color: #f97316; font-weight: 800;"><%= appointment.patientId.prepTracking.currentStreak || 0 %> Days</strong>
            </div>
            <div style="background: var(--bg); border: 1px solid var(--border); padding: 0.85rem; border-radius: 10px; text-align: center;">
              <span style="font-size: 0.7rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block; margin-bottom: 0.25rem;">📊 Adherence Rate</span>
              <strong id="doc-adherence-rate" style="font-size: 1.5rem; color: var(--primary); font-weight: 800;">--%</strong>
            </div>
            <div style="background: var(--bg); border: 1px solid var(--border); padding: 0.85rem; border-radius: 10px; text-align: center;">
              <span style="font-size: 0.7rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block; margin-bottom: 0.25rem;">📅 Plan Started</span>
              <strong style="font-size: 0.85rem; color: var(--text); font-weight: 800; display: block; margin-top: 0.35rem;"><%= new Date(appointment.patientId.prepTracking.startDate).toISOString().split('T')[0] %></strong>
            </div>
          </div>

          <!-- Compact Calendar Grid -->
          <div style="border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; background: var(--bg);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
              <h4 id="doc-calendar-title" style="font-size: 0.95rem; font-weight: 700; color: var(--text); margin: 0;"></h4>
              <div style="display: flex; gap: 0.25rem;">
                <button type="button" onclick="docChangeMonth(-1)" class="btn btn-sm" style="padding: 0.25rem 0.5rem; background: white; border: 1px solid var(--border); font-size: 0.75rem; border-radius: 6px; cursor: pointer; color: var(--text); width: auto;">←</button>
                <button type="button" onclick="docChangeMonth(1)" class="btn btn-sm" style="padding: 0.25rem 0.5rem; background: white; border: 1px solid var(--border); font-size: 0.75rem; border-radius: 6px; cursor: pointer; color: var(--text); width: auto;">→</button>
              </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 0.35rem; text-align: center; font-weight: 700; font-size: 0.68rem; color: var(--text-secondary); border-bottom: 1px solid var(--border); padding-bottom: 0.35rem; margin-bottom: 0.35rem;">
              <div>SU</div><div>MO</div><div>TU</div><div>WE</div><div>TH</div><div>FR</div><div>SA</div>
            </div>

            <div id="doc-calendar-grid" style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 0.35rem; text-align: center; font-size: 0.8rem;">
              <!-- Calendar cells rendered by JS -->
            </div>
          </div>

          <script>
            const docAdherenceLog = <%- JSON.stringify(appointment.patientId.prepTracking.adherenceLog || []) %>;
            let docCurrentYear = new Date().getFullYear();
            let docCurrentMonth = new Date().getMonth();
            const docMonthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

            function docRenderCalendar() {
              const firstDayIndex = new Date(docCurrentYear, docCurrentMonth, 1).getDay();
              const lastDay = new Date(docCurrentYear, docCurrentMonth + 1, 0).getDate();
              document.getElementById('doc-calendar-title').innerText = `${docMonthNames[docCurrentMonth]} ${docCurrentYear}`;
              
              const grid = document.getElementById('doc-calendar-grid');
              grid.innerHTML = '';

              for (let i = 0; i < firstDayIndex; i++) {
                const blank = document.createElement('div');
                blank.style.padding = '0.4rem 0';
                grid.appendChild(blank);
              }

              for (let day = 1; day <= lastDay; day++) {
                const dayCell = document.createElement('div');
                const dateStr = `${docCurrentYear}-${(docCurrentMonth + 1).toString().padStart(2, '0')}-${day.toString().padStart(2, '0')}`;
                
                dayCell.style = 'padding: 0.4rem 0; border: 1px solid var(--border); border-radius: 6px; font-weight: 600; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 34px; background: white;';
                dayCell.innerText = day;

                const logEntry = docAdherenceLog.find(e => e.date === dateStr);
                if (logEntry && logEntry.taken) {
                  dayCell.style.background = 'rgba(13, 148, 136, 0.15)';
                  dayCell.style.borderColor = 'var(--primary)';
                  dayCell.style.color = 'var(--primary)';
                  
                  const dot = document.createElement('span');
                  dot.innerText = '•';
                  dot.style.fontSize = '0.6rem';
                  dot.style.lineHeight = '0.5';
                  dayCell.appendChild(dot);
                } else if (new Date(dateStr) > new Date()) {
                  dayCell.style.color = 'var(--text-muted)';
                  dayCell.style.opacity = '0.5';
                }
                grid.appendChild(dayCell);
              }
            }

            function docCalculateStats() {
              if (docAdherenceLog.length === 0) {
                document.getElementById('doc-adherence-rate').innerText = '0%';
                return;
              }
              const start = new Date('<%= appointment.patientId.prepTracking.startDate %>');
              const today = new Date();
              let totalDays = 0;
              let takenDays = 0;
              
              for (let d = new Date(start); d <= today; d.setDate(d.getDate() + 1)) {
                totalDays++;
                const dateStr = d.toISOString().split('T')[0];
                const entry = docAdherenceLog.find(e => e.date === dateStr);
                if (entry && entry.taken) {
                  takenDays++;
                }
              }
              const rate = totalDays > 0 ? Math.round((takenDays / totalDays) * 100) : 100;
              document.getElementById('doc-adherence-rate').innerText = `${rate}%`;
            }

            function docChangeMonth(direction) {
              docCurrentMonth += direction;
              if (docCurrentMonth < 0) { docCurrentMonth = 11; docCurrentYear--; }
              else if (docCurrentMonth > 11) { docCurrentMonth = 0; docCurrentYear++; }
              docRenderCalendar();
            }

            document.addEventListener('DOMContentLoaded', () => {
              docRenderCalendar();
              docCalculateStats();
            });
          </script>
        <% } else { %>
          <div style="background: rgba(255,255,255,0.02); border: 1px dashed var(--border); padding: 1.5rem; border-radius: 12px; text-align: center; color: var(--text-secondary); font-size: 0.9rem;">
            Patient has not activated their PrEP Adherence Tracker yet.
          </div>
        <% } %>
      </div>
    <% } %>
  </div>

  <!-- Right Side: Prescriptions and Messaging -->
  <div style="display: flex; flex-direction: column; gap: 2rem;">
    
    <!-- Prescription Section -->
    <div class="card-premium">
      <h2 style="color: var(--text); font-size: 1.35rem; font-weight: 700; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary);"><path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"/><path d="m8.5 8.5 7 7"/></svg>
        Digital Rx Prescription
      </h2>

      <% if (appointment.prescription && appointment.prescription.medication) { %>
        <div id="prescription-content" style="background: rgba(13, 148, 136, 0.03); border: 1px solid rgba(13, 148, 136, 0.15); padding: 1.25rem; border-radius: 12px; margin-bottom: 1rem;">
          <p style="margin-bottom: 0.6rem; font-size: 0.92rem;"><strong style="color: var(--text);">Medication:</strong> <span style="font-weight: 600;"><%= appointment.prescription.medication %></span></p>
          <p style="margin-bottom: 0.6rem; font-size: 0.92rem;"><strong style="color: var(--text);">Dosage:</strong> <%= appointment.prescription.dosage %></p>
          <p style="margin-bottom: 0.5rem; font-size: 0.92rem;"><strong style="color: var(--text);">Directives &amp; Clinical Notes:</strong></p>
          <p style="color: var(--text-secondary); font-size: 0.88rem; line-height: 1.5; white-space: pre-line; margin: 0;"><%= appointment.prescription.notes %></p>
          
          <!-- Verification Pin & QR Badge -->
          <div style="margin-top: 1.25rem; padding: 1rem; background: var(--bg); border: 1px solid var(--border); border-radius: 10px; display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
            <div>
              <h4 style="margin: 0 0 0.25rem 0; font-size: 0.9rem; font-weight: 700; color: var(--text);">🔍 Pharmacist Verification Code</h4>
              <p style="margin: 0 0 0.5rem 0; font-size: 0.8rem; color: var(--text-secondary);">Provide this PIN to your pharmacist to verify prescription authenticity.</p>
              <div style="display: flex; align-items: center; gap: 0.75rem;">
                <span style="font-family: monospace; font-size: 1.1rem; font-weight: 800; color: var(--primary); background: rgba(13, 148, 136, 0.08); border: 1px dashed var(--primary); padding: 0.3rem 0.6rem; border-radius: 6px;">
                  PIN: <%= appointment.prescription.verificationPin || 'N/A' %>
                </span>
                <a href="/prescription/verify/<%= appointment._id %>" target="_blank" style="font-size: 0.82rem; color: var(--primary); font-weight: 600; text-decoration: underline;">
                  Open portal →
                </a>
              </div>
            </div>
            <div style="text-align: center;">
              <img src="https://api.qrserver.com/v1/create-qr-code/?size=90x90&data=<%= encodeURIComponent((process.env.APP_URL || 'http://localhost:3001') + '/prescription/verify/' + appointment._id) %>" alt="Prescription Verification QR Code" style="border: 2px solid var(--border); border-radius: 6px; background: white; padding: 2px;" width="90" height="90">
              <span style="display: block; font-size: 0.65rem; color: var(--text-muted); margin-top: 0.2rem; font-weight: 600;">SCAN TO VERIFY</span>
            </div>
          </div>

          <div style="text-align: right; font-size: 0.72rem; color: var(--text-muted); margin-top: 1.25rem; border-top: 1px solid rgba(13, 148, 136, 0.1); padding-top: 0.5rem; display: flex; justify-content: space-between; align-items: center;">
            <span>Last updated: <%= new Date(appointment.prescription.updatedAt).toLocaleString() %></span>
            <button onclick="downloadPrescriptionPDF()" class="btn" style="background: var(--primary); color: white; padding: 0.35rem 0.85rem; border-radius: 8px; font-size: 0.75rem; border: none; font-weight: 600; display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Download PDF
            </button>
          </div>
        </div>

        <!-- html2pdf for Prescription Download -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
        <script>
          function downloadPrescriptionPDF() {
            const element = document.getElementById('prescription-content');
            const opt = {
              margin:       1,
              filename:     'Prescription_<%= appointment._id %>.pdf',
              image:        { type: 'jpeg', quality: 0.98 },
              html2canvas:  { scale: 2 },
              jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' }
            };
            html2pdf().set(opt).from(element).save();
          }
        </script>
      <% } else { %>
        <div style="background: rgba(255,255,255,0.02); border: 1px dashed var(--border); padding: 1.75rem; border-radius: 12px; text-align: center; margin-bottom: 1rem; color: var(--text-secondary); font-size: 0.9rem;">
          No digital prescription issued yet.
        </div>
      <% } %>

      <!-- Form to update prescription (Doctor only) -->
      <% if (role === 'doctor') { %>
        <div style="margin-top: 1.5rem; border-top: 1px solid var(--border); padding-top: 1.5rem;">
          <h3 style="color: var(--text); font-size: 1.15rem; font-weight: 700; margin-bottom: 1rem;">Issue / Update Prescription</h3>
          <form action="/appointments/<%= appointment._id %>/prescription" method="POST" style="display: flex; flex-direction: column; gap: 1.25rem;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            
            <div class="form-group" style="display: flex; flex-direction: column; gap: 0.4rem;">
              <label for="preset-template" style="font-size: 0.85rem; font-weight: 700; color: var(--primary);">✨ Auto-Generate Prescription Template</label>
              <select id="preset-template" class="form-control" style="padding: 0.5rem; font-size: 0.88rem; width: 100%; border: 1px solid var(--border); border-radius: 8px; background: white;" onchange="applyPrescriptionTemplate(this.value)">
                <option value="">-- Choose a standard regime --</option>
                <option value="prep">Standard PrEP Plan (Daily Adherence)</option>
                <option value="pep">Standard PEP Plan (Emergency 28-day Course)</option>
              </select>
            </div>

            <div class="form-group" style="display: flex; flex-direction: column; gap: 0.4rem;">
              <label for="medication" style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary);">Medication Name</label>
              <input type="text" name="medication" id="medication" class="form-control" value="<%= appointment.prescription ? appointment.prescription.medication : '' %>" placeholder="e.g. Tenofovir disoproxil/Emtricitabine (PrEP)" required>
            </div>
            
            <div class="form-group" style="display: flex; flex-direction: column; gap: 0.4rem;">
              <label for="dosage" style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary);">Dosage Schedule</label>
              <input type="text" name="dosage" id="dosage" class="form-control" value="<%= appointment.prescription ? appointment.prescription.dosage : '' %>" placeholder="e.g. 1 Tablet daily with food" required>
            </div>

            <div class="form-group" style="display: flex; flex-direction: column; gap: 0.4rem;">
              <label for="notes" style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary);">Clinical Directives</label>
              <textarea name="notes" id="notes" rows="3" class="form-control" placeholder="Specify monitor parameters, diagnostic advice, or follow-up timelines..." style="resize: vertical;"><%= appointment.prescription ? appointment.prescription.notes : '' %></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="align-self: flex-start; padding: 0.55rem 1.5rem; font-weight: 700; font-size: 0.9rem;">
              💾 Save Prescription
            </button>
          </form>
        </div>

        <script>
          function applyPrescriptionTemplate(type) {
            const medicationField = document.getElementById('medication');
            const dosageField = document.getElementById('dosage');
            const notesField = document.getElementById('notes');

            if (type === 'prep') {
              medicationField.value = 'Emtricitabine / Tenofovir disoproxil fumarate (PrEP)';
              dosageField.value = '1 Tablet daily with food';
              notesField.value = 'Take one tablet daily at approximately the same time. Ensure quarterly HIV testing and kidney function tests (eGFR). Follow the daily compliance tracker.';
            } else if (type === 'pep') {
              medicationField.value = 'Tenofovir DF / Emtricitabine + Dolutegravir (PEP)';
              dosageField.value = 'Take 1 tablet of Tenofovir/Emtricitabine once daily, and 1 tablet of Dolutegravir once daily for 28 days.';
              notesField.value = 'Emergency Post-Exposure Prophylaxis. Must complete the full 28-day course. Schedule follow-up HIV screenings at 4 weeks and 12 weeks. Report any severe side effects immediately.';
            }
          }
        </script>
      <% } %>

      <!-- Star Rating & Consultation Feedback (Patient Only for Completed/Confirmed visits) -->
      <% if (role === 'patient') { %>
        <div style="margin-top: 1.5rem; border-top: 1px solid var(--border); padding-top: 1.5rem;">
          <h3 style="color: var(--text); font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.4rem;">
            ⭐ Practitioner Feedback & Rating
          </h3>
          <p style="color: var(--text-secondary); font-size: 0.85rem; margin: 0 0 1rem 0;">Help us ensure highest clinical quality by rating your consultation experience.</p>

          <form action="/appointments/<%= appointment._id %>/rate" method="POST" style="display: flex; flex-direction: column; gap: 1rem; background: rgba(15, 23, 42, 0.02); padding: 1.25rem; border-radius: 12px; border: 1px solid var(--border);">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div style="display: flex; flex-direction: column; gap: 0.4rem;">
              <label for="score" style="font-size: 0.82rem; font-weight: 700; color: var(--text);">Select Star Rating</label>
              <select name="score" id="score" class="form-control" style="width: 100%; border-radius: 8px; padding: 0.55rem; background: white; border: 1px solid var(--border); font-weight: 600; color: #d97706;">
                <option value="5" selected>⭐⭐⭐⭐⭐ 5 - Exceptional Consultation</option>
                <option value="4">⭐⭐⭐⭐ 4 - Good Guidance</option>
                <option value="3">⭐⭐⭐ 3 - Satisfactory</option>
                <option value="2">⭐⭐ 2 - Needs Improvement</option>
                <option value="1">⭐ 1 - Unsatisfactory</option>
              </select>
            </div>

            <div style="display: flex; flex-direction: column; gap: 0.4rem;">
              <label for="reviewText" style="font-size: 0.82rem; font-weight: 700; color: var(--text);">Your Clinical Feedback / Review</label>
              <textarea name="reviewText" id="reviewText" rows="3" class="form-control" placeholder="Share your experience regarding practitioner empathy, clarity, and guidance..." style="resize: vertical; border-radius: 8px; border: 1px solid var(--border); padding: 0.6rem;"></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="align-self: flex-start; padding: 0.55rem 1.25rem; font-weight: 700; font-size: 0.85rem; border-radius: 8px; background: #0d9488;">
              Submit Practitioner Rating
            </button>
          </form>
        </div>
      <% } %>
    </div>

    <!-- Communication Hub (Chat) -->
    <div class="card-premium">
      <h2 style="color: var(--text); font-size: 1.35rem; font-weight: 700; display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary);"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        Follow-up Consultation Chat
      </h2>
      <p style="font-size: 0.85rem; color: var(--text-secondary); border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; margin: 0 0 1.5rem 0;">Direct encrypted messaging log with your consulting physician.</p>

      <div class="chat-container" style="display: flex; flex-direction: column; justify-content: space-between; min-height: 400px; border: 1px solid var(--border); border-radius: 12px; background: var(--bg); padding: 1.5rem; gap: 1.5rem;">
        
        <!-- Encryption Control Bar -->
        <div style="background: var(--card-bg); border: 1px solid var(--border); border-radius: 10px; padding: 0.75rem 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <input type="checkbox" id="e2ee-toggle" checked style="width: 16px; height: 16px; accent-color: var(--primary);">
            <label for="e2ee-toggle" style="font-size: 0.85rem; font-weight: 700; color: var(--text); display: flex; align-items: center; gap: 0.35rem; cursor: pointer; user-select: none;">
              🔒 Browser-Side Encrypted Chat Mode (E2EE)
            </label>
          </div>
          <div style="font-size: 0.72rem; color: var(--text-secondary); font-weight: 600;">
            Key: <span style="font-family: monospace; color: var(--primary);">Derived-AES-<%= appointment._id.toString().slice(-6) %></span>
          </div>
        </div>

        <div class="chat-history" style="display: flex; flex-direction: column; gap: 1rem; overflow-y: auto; flex-grow: 1; max-height: 350px;">
          <% if (appointment.messages && appointment.messages.length > 0) { %>
            <% appointment.messages.forEach(msg => { %>
              <% const isDoc = msg.sender === 'doctor'; %>
              <div class="chat-bubble <%= isDoc ? 'doctor' : 'patient' %> <%= msg.isEncrypted ? 'e2ee-encrypted' : '' %>" data-content="<%= msg.content %>">
                <strong style="font-size: 0.75rem; font-weight: 700; color: <%= isDoc ? 'var(--primary)' : 'rgba(255,255,255,0.9)' %>; display: block; margin-bottom: 0.25rem;">
                  <%= isDoc ? 'Specialist Physician' : 'Patient' %>
                  <% if (msg.isEncrypted) { %>
                    <span style="color: #14b8a6; font-size: 0.65rem; margin-left: 0.35rem; font-weight: 700; background: rgba(20, 184, 166, 0.1); padding: 0.1rem 0.35rem; border-radius: 4px;">🔒 E2EE SECURE</span>
                  <% } %>
                </strong>
                <div class="message-text" style="white-space: pre-wrap;"><%= msg.content %></div>
                <span class="chat-meta"><%= new Date(msg.timestamp).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></span>
              </div>
            <% }) %>
          <% } else { %>
            <div style="text-align: center; color: var(--text-muted); padding: 4rem 1rem; font-size: 0.9rem; margin: auto;">
              No messages exchanged yet. Send a query below to begin the consultation session.
            </div>
          <% } %>
        </div>

        <form id="chat-form" action="/appointments/<%= appointment._id %>/message" method="POST" class="chat-input-area" style="display: flex; gap: 0.75rem; align-items: center; border-top: 1px solid var(--border); padding-top: 1rem; margin: 0;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="isEncrypted" id="is-encrypted-hidden" value="false">
          <input type="text" name="content" id="chat-input" class="form-control" style="flex-grow: 1; padding: 0.65rem 1rem; border-radius: 999px; background: var(--card-bg); border: 1px solid var(--border);" placeholder="Type a follow-up message..." required autocomplete="off">
          <button type="submit" class="btn btn-primary" style="padding: 0.65rem 1.5rem; border-radius: 999px; font-weight: 700;">Send</button>
        </form>
      </div>
    </div>

  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>
<script>
  const encryptionKey = "<%= appointment._id %>"; // Derived shared key from appointment ID
  
  // Decrypt all E2EE messages on page load
  document.querySelectorAll('.chat-bubble.e2ee-encrypted').forEach(bubble => {
    const cipher = bubble.getAttribute('data-content');
    const textEl = bubble.querySelector('.message-text');
    try {
      const bytes = CryptoJS.AES.decrypt(cipher, encryptionKey);
      const plaintext = bytes.toString(CryptoJS.enc.Utf8);
      if (plaintext) {
        textEl.textContent = plaintext;
      } else {
        textEl.innerHTML = '<span style="color: var(--text-muted); font-style: italic;">🔒 [Encrypted Message Content - Key Required]</span>';
      }
    } catch (e) {
      textEl.innerHTML = '<span style="color: var(--text-muted); font-style: italic;">🔒 [Encrypted Message Content - Decryption failed]</span>';
    }
  });

  // Intercept form submission to encrypt message if checked
  const chatForm = document.getElementById('chat-form');
  if (chatForm) {
    chatForm.addEventListener('submit', (e) => {
      const inputEl = document.getElementById('chat-input');
      const toggleEl = document.getElementById('e2ee-toggle');
      const isEncryptedEl = document.getElementById('is-encrypted-hidden');
      
      if (toggleEl && toggleEl.checked) {
        const plainText = inputEl.value.trim();
        if (plainText) {
          const ciphertext = CryptoJS.AES.encrypt(plainText, encryptionKey).toString();
          inputEl.value = ciphertext;
          isEncryptedEl.value = 'true';
        }
      } else {
        isEncryptedEl.value = 'false';
      }
    });
  }
</script>

<%- include('../partials/footer') %>
